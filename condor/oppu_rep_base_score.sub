# Score the base arms (their evaluator + rouge over all preds) and
# render the 3-arm figure. CPU-only; NEVER run this on a login node
# (2 GB cgroup cap). Generated by condor/gen_oppu_subs.py.

universe              = docker
docker_image          = ghcr.io/gordofreemo/smollm3-train:ver4
executable            = /home/ange00008/projects/mobileFT_distill/eval/plot_oppu_rep.py
arguments             = --score-only

output                = /home/ange00008/projects/mobileFT_distill/runlogs/oppu_rep_base_score.$(ClusterId).$(ProcId).out
error                 = /home/ange00008/projects/mobileFT_distill/runlogs/oppu_rep_base_score.$(ClusterId).$(ProcId).err
log                   = /home/ange00008/projects/mobileFT_distill/runlogs/oppu_rep_base_score.$(ClusterId).log

should_transfer_files = YES
stream_output           = true
stream_error            = true
when_to_transfer_output = ON_EXIT_OR_EVICT
environment           = "PROJECT_ROOT=/home/ange00008/projects/mobileFT_distill CONDOR_CLUSTER_ID=$(ClusterId) CONDOR_PROC_ID=$(ProcId)"

request_CPUs          = 4
request_memory        = 16G
requirements          = UidDomain == "cs.uni-saarland.de"

queue 1
