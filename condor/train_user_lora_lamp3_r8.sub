# User-LoRA Round 8 — LaMP-3 multi-user training on One-LoRA FT (K=100 parallel GPU procs).
#
# Each proc reads a per-user OPPU config from train/config/ (generated by
# data/lamp_user_stats/round8_gen_configs.py from the R8 template) and trains
# a fresh r=8 q+v-only LoRA on top of One-LoRA FT (train/checkpoints/a2_lamp_1ep_seed0/final),
# stacked via train.py's base_adapter plumbing — NOT merged, unchanged from R5's
# stack-vs-merge decision.
#
# Delta over condor/train_user_lora_lamp3.sub (R5): base_adapter is One-LoRA
# FT instead of A1-lamp checkpoint-1000; every config/output path carries an
# _r8 suffix so R5's 100 adapters are never touched; Blackwell capability-
# range guard added (R5's original sub never carried this — see plan axis 12).
#
# OPPU recipe (pinned, do NOT edit, byte-identical to R5):
#   r=8, lora_alpha=16, target_modules=[q_proj, v_proj], lora_dropout=0.05
#   LR=1e-5, weight_decay=1e-2, 3 epochs, cosine + 3% warmup
#   per_device_batch=2, grad_accum=4 (R5's post-OOM working config)
#   max_seq_length=7168 (R5's T3 sizing, reused unchanged)
#
# Acceptance per user (Round-8 plan §Execution sequence Step 6):
#   - train/checkpoints/user_lora_lamp3_<user>_r8_seed0/final/adapter_config.json
#     with r=8, target_modules=["q_proj", "v_proj"]
#   - train_meta.json with base_adapter_path ending in a2_lamp_1ep_seed0/final
#   - non-NaN final loss
#   - All 100 adapters present (or at least 95); surface specifics if 3-5 fail
#
# Smoke (u00008075) passed 2026-07-17: cluster 174460, checkpoint verified,
# base_adapter_path correct, C2'/C3' smoke evals both clean.
#
# Plan: experiments/2026-07-16-user-lora-round8-lamp3-onelora-plan.md
#
# Submit (after committing this file):
#   condor_submit condor/train_user_lora_lamp3_r8.sub

universe              = docker
docker_image          = ghcr.io/gordofreemo/smollm3-train:ver4
executable            = train/train.py
arguments             = --config $(config_path)

output                = /home/ange00008/projects/mobileFT_distill/runlogs/train_user_lora_lamp3_r8.$(ClusterId).$(ProcId).out
error                 = /home/ange00008/projects/mobileFT_distill/runlogs/train_user_lora_lamp3_r8.$(ClusterId).$(ProcId).err
log                   = /home/ange00008/projects/mobileFT_distill/runlogs/train_user_lora_lamp3_r8.$(ClusterId).log

should_transfer_files = YES
environment           = "PROJECT_ROOT=/home/ange00008/projects/mobileFT_distill CONDOR_CLUSTER_ID=$(ClusterId) CONDOR_PROC_ID=$(ProcId)"

gpus_minimum_memory     = 32000
gpus_minimum_capability = 8.0
require_gpus            = Capability >= 8.0 && Capability < 10.0

max_job_retirement_time = 28800

stream_output           = true
stream_error            = true
when_to_transfer_output = ON_EXIT_OR_EVICT

request_GPUs          = 1
request_CPUs          = 4
request_memory        = 32G
requirements          = UidDomain == "cs.uni-saarland.de"
+WantGPUHomeMounted   = true
+WantScratchMounted   = true

