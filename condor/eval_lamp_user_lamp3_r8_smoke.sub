# LaMP eval — Round 8 SMOKE, C3' arm (One-LoRA FT + User-LoRA-R8 stacked +
# BM25) on u00008075. Exercises the full stacking path (base + One-LoRA FT +
# User-LoRA-R8 + BM25 + --user-records) before the 100-proc full submit
# (condor/eval_lamp_user_lamp3_r8.sub).
#
# Adapter points at the Step-4 smoke checkpoint
# (user_lora_lamp3_u00008075_r8_seed0/final) — validates that checkpoint end
# to end, not just that training produced a well-formed directory.
#
# Per the Round-8 plan §Execution sequence Step 5.
#
# Acceptance: clean single-record prediction, no errors, adapter path
# resolves to the Step-4 smoke checkpoint.
#
# First submit (cluster 174462) hit the known transient tyr1 GPU-slot
# oversubscription CUDA error ("CUDA-capable device(s) is/are busy or
# unavailable") documented in CLAUDE.md/project_cluster_infrastructure — same
# class of issue as R6's LaMP-4 retries. Excluded tyr1 below for the retry.
#
# Submit (after committing this file):
#   condor_submit condor/eval_lamp_user_lamp3_r8_smoke.sub

universe              = docker
docker_image          = ghcr.io/gordofreemo/smollm3-train:ver4
executable            = eval/eval_lamp.py

arguments    = --task LaMP_3 --split test --k 4 --seed 0 --adapter /home/ange00008/projects/mobileFT_distill/train/checkpoints/user_lora_lamp3_u00008075_r8_seed0/final --base-adapter /home/ange00008/projects/mobileFT_distill/train/checkpoints/a2_lamp_1ep_seed0/final --user-records u00008075

output                = /home/ange00008/projects/mobileFT_distill/runlogs/eval_lamp_user_lamp3_r8_smoke.$(ClusterId).$(ProcId).out
error                 = /home/ange00008/projects/mobileFT_distill/runlogs/eval_lamp_user_lamp3_r8_smoke.$(ClusterId).$(ProcId).err
log                   = /home/ange00008/projects/mobileFT_distill/runlogs/eval_lamp_user_lamp3_r8_smoke.$(ClusterId).log

should_transfer_files = YES
environment           = "MODEL_OUT_DIR=/home/ange00008/projects/mobileFT_distill/data/models/SmolLM3-3B LAMP_DIR=/home/ange00008/projects/mobileFT_distill/data/lamp_time CONDOR_CLUSTER_ID=$(ClusterId) CONDOR_PROC_ID=$(ProcId)"

max_job_retirement_time = 600
when_to_transfer_output = ON_EXIT_OR_EVICT
stream_output           = true
stream_error            = true

gpus_minimum_memory     = 32000
gpus_minimum_capability = 8.0
require_gpus            = Capability >= 8.0 && Capability < 10.0

request_GPUs          = 1
request_CPUs          = 2
request_memory        = 16G
requirements          = UidDomain == "cs.uni-saarland.de" && Machine != "tyr1.hpc.uni-saarland.de"
+WantGPUHomeMounted   = true
+WantScratchMounted   = true

queue 1
