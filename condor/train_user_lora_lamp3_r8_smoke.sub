# User-LoRA Round 8 — single-user smoke before the 100-proc full submit.
#
# Trains ONE per-user LoRA (u00008075, tied for smallest profile in the
# top-100 with profile_size=405 — same fingerprint used as the "S" sample
# user in the Phase 3 E2E plan) to validate the OPPU recipe stacked on
# One-LoRA FT before submitting condor/train_user_lora_lamp3_r8.sub for the
# full K=100. Per the Round-8 plan §Execution sequence Step 4.
#
# Delta over condor/train_user_lora_lamp3_smoke.sub (R5): config points at
# the _r8 variant (base_adapter = a2_lamp_1ep_seed0/final, not A1-lamp
# checkpoint-1000); output lands at a fresh _r8_seed0 dir so R5's
# user_lora_lamp3_u00008075_seed0 adapter is untouched. R5's own smoke used
# u00010694 (also profile_size=405, a tie); R8's plan explicitly pins
# u00008075 instead, so this is a different user than R5's smoke — not a
# re-run of the same check.
#
# Same hardware / image / docker / GPU class as the main sub, plus the
# Blackwell capability-range guard (R5's original sub never carried this;
# added here preemptively per plan axis 12).
#
# Acceptance (Round-8 plan §Execution sequence Step 4):
#   - train/checkpoints/user_lora_lamp3_u00008075_r8_seed0/final/adapter_config.json
#     with r=8, target_modules=["q_proj", "v_proj"]
#   - train_meta.json has base_adapter_path ending in a2_lamp_1ep_seed0/final
#     (NOT a1_lamp_1ep_seed0/checkpoint-1000)
#   - non-NaN final loss, below first loss
#   - no OOM
#
# Submit (after committing this file):
#   condor_submit condor/train_user_lora_lamp3_r8_smoke.sub

universe              = docker
docker_image          = ghcr.io/gordofreemo/smollm3-train:ver4
executable            = train/train.py
arguments             = --config /home/ange00008/projects/mobileFT_distill/train/config/user_lora_lamp3_oppu_u00008075_r8.json

output                = /home/ange00008/projects/mobileFT_distill/runlogs/train_user_lora_lamp3_r8_smoke.$(ClusterId).$(ProcId).out
error                 = /home/ange00008/projects/mobileFT_distill/runlogs/train_user_lora_lamp3_r8_smoke.$(ClusterId).$(ProcId).err
log                   = /home/ange00008/projects/mobileFT_distill/runlogs/train_user_lora_lamp3_r8_smoke.$(ClusterId).log

should_transfer_files = YES
environment           = "PROJECT_ROOT=/home/ange00008/projects/mobileFT_distill CONDOR_CLUSTER_ID=$(ClusterId) CONDOR_PROC_ID=$(ProcId)"

gpus_minimum_memory     = 32000
gpus_minimum_capability = 8.0
require_gpus            = Capability >= 8.0 && Capability < 10.0

max_job_retirement_time = 28800

stream_output           = true
stream_error            = true
when_to_transfer_output = ON_EXIT_OR_EVICT

request_GPUs          = 1
request_CPUs          = 4
request_memory        = 32G
requirements          = UidDomain == "cs.uni-saarland.de"
+WantGPUHomeMounted   = true
+WantScratchMounted   = true

queue 1
