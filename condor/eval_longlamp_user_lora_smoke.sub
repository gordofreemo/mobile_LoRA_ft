# Step 6 smoke test: one user per task (smallest profile_size, matching the
# Step 5 training smoke and plan decision #13), personalized arm (Task-LoRA
# + User-LoRA stacked + BM25), before the real 300-job
# condor/eval_longlamp_user_lora.sub run.

universe              = docker
docker_image          = ghcr.io/gordofreemo/smollm3-train:ver4
executable            = eval/eval_longlamp.py

task         = product_review_temporal
base_adapter = longlamp_lora_review_1ep_seed0
user_id      = unknown
adapter_ckpt = longlamp_user_lora_review_unknown_seed0

arguments    = "--task $(task) --split test --k 4 --seed 0 --adapter /home/ange00008/projects/mobileFT_distill/train/checkpoints/$(adapter_ckpt)/final --base-adapter /home/ange00008/projects/mobileFT_distill/train/checkpoints/$(base_adapter)/final --user-records '$(user_id)'"

output                = /home/ange00008/projects/mobileFT_distill/runlogs/eval_longlamp_user_lora_smoke.$(task).$(ClusterId).$(ProcId).out
error                 = /home/ange00008/projects/mobileFT_distill/runlogs/eval_longlamp_user_lora_smoke.$(task).$(ClusterId).$(ProcId).err
log                   = /home/ange00008/projects/mobileFT_distill/runlogs/eval_longlamp_user_lora_smoke.$(ClusterId).log

should_transfer_files = YES
environment           = "MODEL_OUT_DIR=/home/ange00008/projects/mobileFT_distill/data/models/SmolLM3-3B LONGLAMP_DIR=/home/ange00008/projects/mobileFT_distill/data/longlamp CONDOR_CLUSTER_ID=$(ClusterId) CONDOR_PROC_ID=$(ProcId)"

max_job_retirement_time = 1800
when_to_transfer_output = ON_EXIT_OR_EVICT
stream_output           = true
stream_error            = true

gpus_minimum_memory     = 32000
gpus_minimum_capability = 8.0
require_gpus            = Capability >= 8.0 && Capability < 10.0

request_GPUs          = 1
request_CPUs          = 2
request_memory        = 16G
requirements          = UidDomain == "cs.uni-saarland.de" && Machine != "tyr1.hpc.uni-saarland.de"
+WantGPUHomeMounted   = true
+WantScratchMounted   = true

queue task, base_adapter, adapter_ckpt, user_id from (
  product_review_temporal, longlamp_lora_review_1ep_seed0, longlamp_user_lora_review_A1K0I7X8P4SIYJ_seed0, A1K0I7X8P4SIYJ
  abstract_generation_temporal, longlamp_lora_abstract_1ep_seed0, longlamp_user_lora_abstract_Qionghai_Dai_seed0, Qionghai Dai
  topic_writing_temporal, longlamp_lora_topic_1ep_seed0, longlamp_user_lora_topic_AngryBeaverEU_seed0, AngryBeaverEU
)
