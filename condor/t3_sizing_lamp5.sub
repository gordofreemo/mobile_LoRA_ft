# T3 sizing for LaMP_5 — pin max_seq_length from the real corpora.
#
# Tokenizes all 100 per-user bm25k4 corpora and pins
# max_seq_length = round_up_to_256(min(global_max, 8192)).
#
# Framing is profile, so tokenization applies the SmolLM3 chat template (matching train.py).
#
# STOPS with a non-zero exit if the global max exceeds the 8192
# positional ceiling — do not auto-truncate, decide jointly.
#
# Run AFTER the per-user corpus build, BEFORE generating configs.
#
# GENERATED by condor/gen_newtask_subs.py — edit that script and
# regenerate rather than hand-editing this file, or the next
# regeneration will silently drop your change.
#
# Submit (after committing this file):
#   condor_submit condor/t3_sizing_lamp5.sub

universe              = docker
docker_image          = ghcr.io/gordofreemo/smollm3-train:ver4
executable            = data/lamp_user_stats/newtask_t3_sizing.py
arguments             = --task LaMP_5 --framing profile

output                = /home/ange00008/projects/mobileFT_distill/runlogs/t3_sizing_lamp5.$(ClusterId).$(ProcId).out
error                 = /home/ange00008/projects/mobileFT_distill/runlogs/t3_sizing_lamp5.$(ClusterId).$(ProcId).err
log                   = /home/ange00008/projects/mobileFT_distill/runlogs/t3_sizing_lamp5.$(ClusterId).log

should_transfer_files = YES
environment           = "PROJECT_ROOT=/home/ange00008/projects/mobileFT_distill CONDOR_CLUSTER_ID=$(ClusterId) CONDOR_PROC_ID=$(ProcId)"

request_CPUs          = 2
request_memory        = 16G
request_disk          = 4G
requirements          = UidDomain == "cs.uni-saarland.de"
+WantGPUHomeMounted   = true
+WantScratchMounted   = true

queue 1
