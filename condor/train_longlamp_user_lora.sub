# Per-user LongLaMP User-LoRA training for LL4 (Review) / LL5 (Abstract) /
# LL6 (Topic Writing) -- 300 parallel GPU procs (3 tasks x K=100 users).
#
# Each proc reads a per-user OPPU config from train/config/ (generated by
# data/longlamp_user_stats/gen_configs.py from the per-task template --
# train/config/longlamp_user_lora_{review,abstract,topic}_oppu_template.json)
# and trains a fresh r=8 q+v-only LoRA stacked on that task's Task-LoRA
# (LL1/LL2/LL3's final checkpoint), via train.py's base_adapter plumbing.
#
# OPPU recipe (pinned, plan decision #5, byte-identical to LaMP's R5/R6/R8):
#   r=8, lora_alpha=16, target_modules=[q_proj, v_proj], lora_dropout=0.05
#   LR=1e-5, weight_decay=1e-2, 3 epochs, cosine + 3% warmup
#   per_device_batch=2, grad_accum=4
#   max_seq_length=1024 -- PLACEHOLDER, per plan decision #5 this must be
#   smoke-tested per task before the real run, NOT assumed to transfer from
#   the Task-LoRA's max_seq_length=8192 (per-user records here retrieve BM25
#   over a single record's own profile, not k=4-over-the-full-profile, so
#   context is likely much shorter -- verify, don't guess).
#
# Plan: experiments/2026-07-27-longlamp-user-lora-ll4-ll6-plan.md, Execution
# Step 5.
#
# REQUIRES condor/build_longlamp_user_dataset.sub to have completed (all 300
# per-user JSONL corpora on disk) and the per-user configs generated via
# data/longlamp_user_stats/gen_configs.py --tag <tag> (no --print-queue).
#
# Acceptance per user (mirrors R5/R6/R8's convention):
#   - train/checkpoints/longlamp_user_lora_<tag>_<user_tag>_seed0/final/adapter_config.json
#     with r=8, target_modules=["q_proj", "v_proj"]
#   - train_meta.json with base_adapter_path ending in the right
#     longlamp_lora_<tag>_1ep_seed0/final
#   - non-NaN final loss
#
# Smoke ONE user per task first (confirms max_seq_length doesn't silently
# truncate/OOM -- do not skip, this project's own history shows smoke tests
# catch real bugs here):
#   condor_submit -i condor/interactive.sub
#   cd /home/ange00008/projects/mobileFT_distill
#   python train/train.py --config train/config/longlamp_user_lora_review_oppu_<smallest-user_tag>.json --max_steps 4

universe              = docker
docker_image          = ghcr.io/gordofreemo/smollm3-train:ver4
executable            = train/train.py
arguments             = --config $(config_path)

output                = /home/ange00008/projects/mobileFT_distill/runlogs/train_longlamp_user_lora.$(ClusterId).$(ProcId).out
error                 = /home/ange00008/projects/mobileFT_distill/runlogs/train_longlamp_user_lora.$(ClusterId).$(ProcId).err
log                   = /home/ange00008/projects/mobileFT_distill/runlogs/train_longlamp_user_lora.$(ClusterId).log

should_transfer_files = YES
environment           = "PROJECT_ROOT=/home/ange00008/projects/mobileFT_distill CONDOR_CLUSTER_ID=$(ClusterId) CONDOR_PROC_ID=$(ProcId)"

gpus_minimum_memory     = 32000
gpus_minimum_capability = 8.0
require_gpus            = Capability >= 8.0 && Capability < 10.0

max_job_retirement_time = 28800

stream_output           = true
stream_error            = true
when_to_transfer_output = ON_EXIT_OR_EVICT

request_GPUs          = 1
request_CPUs          = 4
request_memory        = 32G
requirements          = UidDomain == "cs.uni-saarland.de"
+WantGPUHomeMounted   = true
+WantScratchMounted   = true

