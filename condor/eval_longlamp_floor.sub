# Non-personalized FLOOR for LongLaMP — same eval harness as eval_longlamp.sub,
# but with `--no-profile` so the model sees only the already-templated
# `input` instruction and no user profile. Task defaults to
# product_review_user (LL1); override for LL2/LL3.
#
# Submit alongside the profile baseline, no editing required:
#   condor_submit -a 'task=abstract_generation_user' condor/eval_longlamp.sub        # profile baseline (BM25 k=4)
#   condor_submit -a 'task=abstract_generation_user' condor/eval_longlamp_floor.sub  # non-personalized floor

universe              = docker
docker_image          = ghcr.io/gordofreemo/smollm3-train:ver4
executable            = eval/eval_longlamp.py

split                 = test
task                  = product_review_user
arguments             = --task $(task) --split $(split) --no-profile --seed 0 --resume

output                = /home/ange00008/projects/mobileFT_distill/runlogs/eval_longlamp_floor.$(task).$(ClusterId).$(ProcId).out
error                 = /home/ange00008/projects/mobileFT_distill/runlogs/eval_longlamp_floor.$(task).$(ClusterId).$(ProcId).err
log                   = /home/ange00008/projects/mobileFT_distill/runlogs/eval_longlamp_floor.$(ClusterId).log

should_transfer_files   = YES
when_to_transfer_output = ON_EXIT_OR_EVICT
stream_output           = true
stream_error            = true
environment             = "MODEL_OUT_DIR=/home/ange00008/projects/mobileFT_distill/data/models/SmolLM3-3B LONGLAMP_DIR=/home/ange00008/projects/mobileFT_distill/data/longlamp CONDOR_CLUSTER_ID=$(ClusterId) CONDOR_PROC_ID=$(ProcId)"

gpus_minimum_memory     = 32000
gpus_minimum_capability = 8.0
require_gpus            = Capability >= 8.0 && Capability < 10.0
max_job_retirement_time = 600

request_GPUs          = 1
request_CPUs          = 2
request_memory        = 16G
requirements          = UidDomain == "cs.uni-saarland.de"
+WantGPUHomeMounted   = true
+WantScratchMounted   = true

queue 1
