# Paired comparison -- PT2 (LaMP-4 User-LoRA on Per-Task-LoRA(LaMP-4)).
#
# CPU-only job. Runs eval/paired_compare_per_user.py UNMODIFIED on the
# consolidated C2-PT2 vs C3-PT2 prediction files:
#   pred-a: results/LaMP_4_test_pt2_C2.predictions.jsonl
#   pred-b: results/LaMP_4_test_pt2_C3.predictions.jsonl
#
# Same script R6 used (eval/paired_compare_per_user.py, not the flat
# eval/paired_compare.py PT1 used) -- LaMP-4 users have 1-25 test records
# each, so this scores ROUGE-1 per record then groups by user, pairing at
# the per-user-mean level (K=100 paired observations), same as R6.
#
# NO pre-registered gate this round (same convention as R6/R8/R9/PT1) --
# paired_compare_per_user.py still emits p-values/CI/wins-ties-losses as
# always, they're just reported side-by-side with R6's archived mean ΔR-1
# +0.007 (not significant, p=0.20), not used for a pass/fail decision.
#
# Must run via condor_submit, not directly -- scipy isn't on the login node.
#
# Submit (after committing this file, and after the aggregator has run):
#   condor_submit condor/paired_compare_lamp4_ptl.sub

universe              = docker
docker_image          = ghcr.io/gordofreemo/smollm3-train:ver4
executable            = eval/paired_compare_per_user.py

arguments = --pred-a /home/ange00008/projects/mobileFT_distill/results/LaMP_4_test_pt2_C2.predictions.jsonl --pred-b /home/ange00008/projects/mobileFT_distill/results/LaMP_4_test_pt2_C3.predictions.jsonl --label-a c2_ptl_bm25 --label-b c3_ptl_userlora_bm25 --task LaMP_4 --split test --seed 0

output                = /home/ange00008/projects/mobileFT_distill/runlogs/paired_compare_lamp4_ptl.$(ClusterId).$(ProcId).out
error                 = /home/ange00008/projects/mobileFT_distill/runlogs/paired_compare_lamp4_ptl.$(ClusterId).$(ProcId).err
log                   = /home/ange00008/projects/mobileFT_distill/runlogs/paired_compare_lamp4_ptl.$(ClusterId).log

should_transfer_files = YES
environment           = "PROJECT_ROOT=/home/ange00008/projects/mobileFT_distill CONDOR_CLUSTER_ID=$(ClusterId) CONDOR_PROC_ID=$(ProcId)"

request_GPUs          = 0
request_CPUs          = 1
request_memory        = 2G

max_job_retirement_time = 600
when_to_transfer_output = ON_EXIT_OR_EVICT
stream_output           = true
stream_error            = true

requirements          = UidDomain == "cs.uni-saarland.de"
+WantGPUHomeMounted   = true
+WantScratchMounted   = true

queue 1
