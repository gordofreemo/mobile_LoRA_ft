# P24 depth companion: movie-tagging user stage at adapter depths
# 18, 24 of 36 blocks, r5 recipe.
# Scored against the 36-block arm to answer whether half the backward
# pass retains the per-user gain.
# Generated by condor/gen_oppu_subs.py - edit the generator.

universe              = docker
docker_image          = ghcr.io/gordofreemo/smollm3-train:ver4
executable            = /home/ange00008/projects/mobileFT_distill/oppu_replication/run_oppu.py
arguments             = --task_name movie_tagging --k 1 --user-recipe r5 --lora-layers $(depth) --tag _r5d$(depth) --task_lora /home/ange00008/projects/mobileFT_distill/train/checkpoints/oppu_rep/movie_tagging/task_lora_k1 --user-start $(ustart) --user-end $(uend)

output                = /home/ange00008/projects/mobileFT_distill/runlogs/oppu_rep_depth_user_d$(depth)_$(ustart).$(ClusterId).$(ProcId).out
error                 = /home/ange00008/projects/mobileFT_distill/runlogs/oppu_rep_depth_user_d$(depth)_$(ustart).$(ClusterId).$(ProcId).err
log                   = /home/ange00008/projects/mobileFT_distill/runlogs/oppu_rep_depth_user_d$(depth)_$(ustart).$(ClusterId).log

should_transfer_files = YES
stream_output           = true
stream_error            = true
when_to_transfer_output = ON_EXIT_OR_EVICT
environment           = "PROJECT_ROOT=/home/ange00008/projects/mobileFT_distill CONDOR_CLUSTER_ID=$(ClusterId) CONDOR_PROC_ID=$(ProcId)"

request_GPUs          = 1
request_CPUs          = 4
request_memory        = 32G
requirements          = UidDomain == "cs.uni-saarland.de" && Machine != "tyr1.hpc.uni-saarland.de" && Machine != "tyr2.hpc.uni-saarland.de" && Machine != "modi.hpc.uni-saarland.de"
+WantGPUHomeMounted   = true
gpus_minimum_memory     = 40000
gpus_minimum_capability = 8.0
require_gpus            = Capability >= 8.0 && Capability < 10.0
max_job_retirement_time = 28800

