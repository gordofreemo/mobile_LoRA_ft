# LongLaMP decoding sweep -- GENERATED by condor/gen_longlamp_decoding_sweep_subs.py
# Edit the generator, not this file.
#
# Branch A step 1: find a decoding config that stops the Task-LoRA repetition
# loop, chosen on the DEV split and then applied identically to every arm when
# LL1-LL6 are re-measured. No retraining -- every adapter is already on disk.
#
# Cells: 2 jobs, --limit 3 each.
# Outputs carry a _limit3 suffix plus a decoding tag, so a sweep cell can
# never collide with a real result file.
#
# Read the results with:
#   python eval/longlamp_length_check.py results/LongLaMP_*_dev_*_limit3.predictions.jsonl
# Admissible = degeneration rate at >600w near zero. Among admissible, pick
# best dev ROUGE-1 from the result JSONs. Never select on test.

universe              = docker
docker_image          = ghcr.io/gordofreemo/smollm3-train:ver4
executable            = eval/eval_longlamp.py

arguments             = --task $(task) --split dev --k 4 --seed 0 --limit 3 --adapter $(adapter) $(decode_args)

output                = /home/ange00008/projects/mobileFT_distill/runlogs/longlamp_decsweep_smoke.$(task).$(cell).$(ClusterId).$(ProcId).out
error                 = /home/ange00008/projects/mobileFT_distill/runlogs/longlamp_decsweep_smoke.$(task).$(cell).$(ClusterId).$(ProcId).err
log                   = /home/ange00008/projects/mobileFT_distill/runlogs/longlamp_decsweep_smoke.$(ClusterId).log

should_transfer_files   = YES
when_to_transfer_output = ON_EXIT_OR_EVICT
stream_output           = true
stream_error            = true
environment             = "MODEL_OUT_DIR=/home/ange00008/projects/mobileFT_distill/data/models/SmolLM3-3B LONGLAMP_DIR=/home/ange00008/projects/mobileFT_distill/data/longlamp CONDOR_CLUSTER_ID=$(ClusterId) CONDOR_PROC_ID=$(ProcId)"

gpus_minimum_memory     = 32000
gpus_minimum_capability = 8.0
# Blackwell (sm_120) guard -- ver4's torch 2.5.1+cu124 cannot target it.
require_gpus            = Capability >= 8.0 && Capability < 10.0
max_job_retirement_time = 600

request_GPUs          = 1
request_CPUs          = 2
request_memory        = 16G
# tyr1 (CUDA-busy oversubscription) and modi (uncorrectable ECC) cost R8 83/100
# jobs on its first big submit. Baked in from the first submit, per the
# convention gen_warm_subs.py / gen_r9_subs.py established.
requirements          = UidDomain == "cs.uni-saarland.de" && Machine != "tyr1.hpc.uni-saarland.de" && Machine != "modi.hpc.uni-saarland.de"
+WantGPUHomeMounted   = true
+WantScratchMounted   = true

queue task,adapter,cell,decode_args from (
  abstract_generation_temporal, /home/ange00008/projects/mobileFT_distill/train/checkpoints/longlamp_lora_abstract_1ep_seed0/final, nrng4, --no-repeat-ngram-size 4
  abstract_generation_temporal, /home/ange00008/projects/mobileFT_distill/train/checkpoints/longlamp_lora_abstract_1ep_seed0/final, sample_p90_t70, --do-sample --top-p 0.9 --temperature 0.7
