# Per-user LaMP_2_news training corpus build — SMOKE (1 user).
#
# Emits data/lamp_user_train_LaMP_2_news_<user>_records_bm25k4.jsonl
# (+ .meta.json) for each user in the pinned pool
# data/lamp_user_stats/LaMP_2_news_top27_users.json.
#
# Framing: --framing records --bm25-k 4
#
# Users hold real train-split records, so the snapshot comes from the
# train split as usual.
#
# build_user_dataset.py refuses to overwrite by default, so a
# re-submit after a partial sweep only fills the gaps. The smoke
# user's file will collide on the full submit — that ONE
# refuse-to-overwrite failure is expected, not a real failure.
#
# SMOKE SUBJECT: u00004112 (smallest profile in the pool).
#
# GENERATED by condor/gen_newtask_subs.py — edit that script and
# regenerate rather than hand-editing this file, or the next
# regeneration will silently drop your change.
#
# Submit (after committing this file):
#   condor_submit condor/build_user_dataset_lamp2news_smoke.sub

universe              = docker
docker_image          = ghcr.io/gordofreemo/smollm3-train:ver4
executable            = train/build_user_dataset.py
arguments             = --task LaMP_2_news --user $(user) --framing records --bm25-k 4

output                = /home/ange00008/projects/mobileFT_distill/runlogs/build_user_dataset_lamp2news_smoke.$(ClusterId).$(ProcId).out
error                 = /home/ange00008/projects/mobileFT_distill/runlogs/build_user_dataset_lamp2news_smoke.$(ClusterId).$(ProcId).err
log                   = /home/ange00008/projects/mobileFT_distill/runlogs/build_user_dataset_lamp2news_smoke.$(ClusterId).log

should_transfer_files = YES
environment           = "PROJECT_ROOT=/home/ange00008/projects/mobileFT_distill LAMP_DIR=/home/ange00008/projects/mobileFT_distill/data/lamp_time CONDOR_CLUSTER_ID=$(ClusterId) CONDOR_PROC_ID=$(ProcId)"

request_CPUs          = 2
request_memory        = 24G
request_disk          = 4G
requirements          = UidDomain == "cs.uni-saarland.de"
+WantGPUHomeMounted   = true
+WantScratchMounted   = true

queue user from (
  u00004112
)
