# R13 baseline arm (C2) — One-LoRA FT alone, K=100 subset.
#
# Every LaMP_2_movies pool user holds exactly ONE test record, so the
# whole baseline is one job: --user-records-from-file pulls each
# user's single test_record_id out of the pool JSON.
#
# No User-LoRA here — this is the arm the per-user adapters are
# compared AGAINST.
#
# Output: results/LaMP_2_movies_test_<basetag>_bm25k4_seed0_topK100.{json,predictions.jsonl}
#
# GENERATED by condor/gen_newtask_subs.py — edit that script and
# regenerate rather than hand-editing this file, or the next
# regeneration will silently drop your change.
#
# Submit (after committing this file):
#   condor_submit condor/eval_lamp_user_lamp2movies_r13_baseline.sub

universe              = docker
docker_image          = ghcr.io/gordofreemo/smollm3-train:ver4
executable            = eval/eval_lamp.py

arguments             = --task LaMP_2_movies --split test --k 4 --seed 0 --adapter /home/ange00008/projects/mobileFT_distill/train/checkpoints/a2_lamp_1ep_seed0/final --user-records-from-file /home/ange00008/projects/mobileFT_distill/data/lamp_user_stats/LaMP_2_movies_top100_users.json

output                = /home/ange00008/projects/mobileFT_distill/runlogs/eval_lamp_user_lamp2movies_r13_baseline.$(ClusterId).$(ProcId).out
error                 = /home/ange00008/projects/mobileFT_distill/runlogs/eval_lamp_user_lamp2movies_r13_baseline.$(ClusterId).$(ProcId).err
log                   = /home/ange00008/projects/mobileFT_distill/runlogs/eval_lamp_user_lamp2movies_r13_baseline.$(ClusterId).log

should_transfer_files = YES
environment           = "MODEL_OUT_DIR=/home/ange00008/projects/mobileFT_distill/data/models/SmolLM3-3B LAMP_DIR=/home/ange00008/projects/mobileFT_distill/data/lamp_time CONDOR_CLUSTER_ID=$(ClusterId) CONDOR_PROC_ID=$(ProcId)"

max_job_retirement_time = 600
when_to_transfer_output = ON_EXIT_OR_EVICT
stream_output           = true
stream_error            = true

gpus_minimum_memory     = 32000
gpus_minimum_capability = 8.0
require_gpus            = Capability >= 8.0 && Capability < 10.0

request_GPUs          = 1
request_CPUs          = 2
request_memory        = 16G
requirements          = UidDomain == "cs.uni-saarland.de" && Machine != "tyr1.hpc.uni-saarland.de" && Machine != "modi.hpc.uni-saarland.de"
+WantGPUHomeMounted   = true
+WantScratchMounted   = true

queue 1
