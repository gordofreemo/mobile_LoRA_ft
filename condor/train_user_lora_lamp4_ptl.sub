# PT2 -- LaMP-4 multi-user training on Per-Task-LoRA(LaMP-4) (K=100 parallel GPU procs).
#
# Each proc reads a per-user OPPU config from train/config/ (generated by
# data/lamp_user_stats/pt2_gen_configs.py from the PT2 template) and trains
# a fresh r=8 q+v-only LoRA on top of Per-Task-LoRA(LaMP-4)
# (train/checkpoints/per_task_lamp4_1ep_seed0/final), stacked via train.py's
# base_adapter plumbing -- NOT merged, unchanged from R5/R6's stack-vs-merge
# decision.
#
# Delta over condor/train_user_lora_lamp4_multi.sub: base_adapter is
# Per-Task-LoRA(LaMP-4) instead of A1-lamp; every config/output path carries
# a _ptl suffix so R6's 100 adapters are never touched. Reuses R6's exact
# K=100 pool and per-user JSONL corpora unchanged -- only the base Task-LoRA
# swaps, same mechanical delta PT1 applied to R5/LaMP-3.
#
# OPPU recipe (pinned, do NOT edit, byte-identical to R6):
#   r=8, lora_alpha=16, target_modules=[q_proj, v_proj], lora_dropout=0.05
#   LR=1e-5, weight_decay=1e-2, 3 epochs, cosine + 3% warmup
#   per_device_batch=2, grad_accum=4 (R5/R6's working config)
#   max_seq_length=1024 (R6's T3 sizing, reused unchanged)
#   logging_steps=1 (R6's fix for low-step users, reused unchanged)
#
# Acceptance per user:
#   - train/checkpoints/user_lora_lamp4_<user>_ptl_seed0/final/adapter_config.json
#     with r=8, target_modules=["q_proj", "v_proj"]
#   - train_meta.json with base_adapter_path ending in per_task_lamp4_1ep_seed0/final
#   - non-NaN final loss
#   - All 100 adapters present (or at least 95); surface specifics if 3-5 fail
#
# Run the smoke sub (condor/train_user_lora_lamp4_ptl_smoke.sub) first.
#
# Plan: experiments/2026-07-25-per-task-lora-pt1-lamp3-pilot-plan.md (PT2 note)
#
# Submit (after committing this file, and after the smoke sub passes):
#   condor_submit condor/train_user_lora_lamp4_ptl.sub

universe              = docker
docker_image          = ghcr.io/gordofreemo/smollm3-train:ver4
executable            = train/train.py
arguments             = --config $(config_path)

output                = /home/ange00008/projects/mobileFT_distill/runlogs/train_user_lora_lamp4_ptl.$(ClusterId).$(ProcId).out
error                 = /home/ange00008/projects/mobileFT_distill/runlogs/train_user_lora_lamp4_ptl.$(ClusterId).$(ProcId).err
log                   = /home/ange00008/projects/mobileFT_distill/runlogs/train_user_lora_lamp4_ptl.$(ClusterId).log

should_transfer_files = YES
environment           = "PROJECT_ROOT=/home/ange00008/projects/mobileFT_distill CONDOR_CLUSTER_ID=$(ClusterId) CONDOR_PROC_ID=$(ProcId)"

gpus_minimum_memory     = 32000
gpus_minimum_capability = 8.0
require_gpus            = Capability >= 8.0 && Capability < 10.0

max_job_retirement_time = 28800

stream_output           = true
stream_error            = true
when_to_transfer_output = ON_EXIT_OR_EVICT

request_GPUs          = 1
request_CPUs          = 4
request_memory        = 32G
requirements          = UidDomain == "cs.uni-saarland.de" && Machine != "tyr1.hpc.uni-saarland.de" && Machine != "modi.hpc.uni-saarland.de"
+WantGPUHomeMounted   = true
+WantScratchMounted   = true

