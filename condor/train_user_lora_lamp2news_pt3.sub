# PT3 — LaMP_2_news User-LoRA on Per-Task-LoRA(LaMP_2_news) (K=27 parallel GPU procs).
#
# Trains a fresh r=8 q+v LoRA per user on top of train/checkpoints/per_task_lamp2_news_1ep_seed0/final,
# stacked via base_adapter (merged into the backbone, NOT a second
# live adapter) — unchanged from R5/R6's stack-vs-merge decision.
#
# Objective: the standard supervised SFT objective (train/train.py).
#
# OPPU recipe (pinned, do NOT edit): r=8, alpha=16, q_proj+v_proj,
# dropout=0.05, LR=1e-5, weight_decay=1e-2, 3 epochs, cosine + 3%
# warmup, per_device_batch=2, grad_accum=4, logging_steps=1.
# max_seq_length comes from this task's own T3 sizing pass.
#
# Configs are generated by
# data/lamp_user_stats/newtask_gen_configs.py --track pt3.
#
# Acceptance per user: final/adapter_config.json with r=8 and
# target_modules=[q_proj, v_proj]; train_meta.json whose
# base_adapter_path ends in per_task_lamp2_news_1ep_seed0/final;
# non-NaN final loss.
#
# Run condor/train_user_lora_lamp2news_pt3_smoke.sub first.
# The smoke user recurs here and will hit one expected
# refuse-to-overwrite failure.
#
# GENERATED by condor/gen_newtask_subs.py — edit that script and
# regenerate rather than hand-editing this file, or the next
# regeneration will silently drop your change.
#
# Submit (after committing this file):
#   condor_submit condor/train_user_lora_lamp2news_pt3.sub

universe              = docker
docker_image          = ghcr.io/gordofreemo/smollm3-train:ver4
executable            = train/train.py
arguments             = --config $(config_path)

output                = /home/ange00008/projects/mobileFT_distill/runlogs/train_user_lora_lamp2news_pt3.$(ClusterId).$(ProcId).out
error                 = /home/ange00008/projects/mobileFT_distill/runlogs/train_user_lora_lamp2news_pt3.$(ClusterId).$(ProcId).err
log                   = /home/ange00008/projects/mobileFT_distill/runlogs/train_user_lora_lamp2news_pt3.$(ClusterId).log

should_transfer_files = YES
environment           = "PROJECT_ROOT=/home/ange00008/projects/mobileFT_distill CONDOR_CLUSTER_ID=$(ClusterId) CONDOR_PROC_ID=$(ProcId)"

gpus_minimum_memory     = 32000
gpus_minimum_capability = 8.0
require_gpus            = Capability >= 8.0 && Capability < 10.0

max_job_retirement_time = 28800

stream_output           = true
stream_error            = true
when_to_transfer_output = ON_EXIT_OR_EVICT

request_GPUs          = 1
request_CPUs          = 4
request_memory        = 32G
requirements          = UidDomain == "cs.uni-saarland.de" && Machine != "tyr1.hpc.uni-saarland.de" && Machine != "modi.hpc.uni-saarland.de"
+WantGPUHomeMounted   = true
+WantScratchMounted   = true

