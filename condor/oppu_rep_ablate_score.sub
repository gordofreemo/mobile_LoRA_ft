# Score the ablation + re-decode arms of movie tagging. The '.' task
# tag means untagged (cold arm shares the original task baseline).
# CPU-only, in-container bootstrap. Generated by gen_oppu_subs.py.

universe              = docker
docker_image          = ghcr.io/gordofreemo/smollm3-train:ver4
executable            = /home/ange00008/projects/mobileFT_distill/oppu_replication/run_scoring_in_container.sh
arguments             = /home/ange00008/projects/mobileFT_distill/eval/oppu_rep_score.py --task movie_tagging --oppu-tag $(otag) --task-tag $(ttag) --out-tag $(gtag)

output                = /home/ange00008/projects/mobileFT_distill/runlogs/oppu_rep_ablate_score_$(otag).$(ClusterId).$(ProcId).out
error                 = /home/ange00008/projects/mobileFT_distill/runlogs/oppu_rep_ablate_score_$(otag).$(ClusterId).$(ProcId).err
log                   = /home/ange00008/projects/mobileFT_distill/runlogs/oppu_rep_ablate_score_$(otag).$(ClusterId).log

should_transfer_files = YES
stream_output           = true
stream_error            = true
when_to_transfer_output = ON_EXIT_OR_EVICT
environment           = "PROJECT_ROOT=/home/ange00008/projects/mobileFT_distill CONDOR_CLUSTER_ID=$(ClusterId) CONDOR_PROC_ID=$(ProcId)"

request_CPUs          = 4
request_memory        = 16G
requirements          = UidDomain == "cs.uni-saarland.de"
+WantGPUHomeMounted   = true

queue otag, ttag, gtag from (
    _r5 . _r5
    _seed1 _seed1 _seed1
    _seed2 _seed2 _seed2
)
