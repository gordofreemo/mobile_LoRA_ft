# LongLaMP training-corpus preprocessing — one-shot CPU job, one proc per task.
#
# BM25 top-k retrieval (k=4) over each user's profile, PPEP-templated
# (paper-verbatim, see train/build_longlamp_dataset.py's TASKS dict), writes
# a compact training-ready JSONL + provenance meta sidecar per task.
#
# product_review_user's corpus (LL1) is already built -- this queue list
# covers only the two new tasks (LL2, LL3). To re-run product_review_user:
#   condor_submit -a 'task=product_review_user' condor/build_longlamp_dataset.sub
#
# Smoke first (also the point to eyeball BM25 retrieval + PPEP rendering):
#   condor_submit -i condor/interactive.sub
#   cd /home/ange00008/projects/mobileFT_distill
#   python train/build_longlamp_dataset.py --task abstract_generation_user --k 4 --limit 20
# Then submit for the real build:
#   condor_submit condor/build_longlamp_dataset.sub

universe              = docker
docker_image          = ghcr.io/gordofreemo/smollm3-train:ver4
executable            = train/build_longlamp_dataset.py
arguments             = --task $(task) --k 4 --seed 0

output                = /home/ange00008/projects/mobileFT_distill/runlogs/build_longlamp_dataset.$(task).$(ClusterId).$(ProcId).out
error                 = /home/ange00008/projects/mobileFT_distill/runlogs/build_longlamp_dataset.$(task).$(ClusterId).$(ProcId).err
log                   = /home/ange00008/projects/mobileFT_distill/runlogs/build_longlamp_dataset.$(ClusterId).log

should_transfer_files = YES
environment           = "LONGLAMP_DIR=/home/ange00008/projects/mobileFT_distill/data/longlamp DATA_OUT_DIR=/home/ange00008/projects/mobileFT_distill/data CONDOR_CLUSTER_ID=$(ClusterId) CONDOR_PROC_ID=$(ProcId)"

# CPU-only — no GPU needed for BM25 + JSONL write.
request_CPUs          = 2
request_memory        = 8G
request_disk          = 2G
requirements          = UidDomain == "cs.uni-saarland.de"
+WantGPUHomeMounted   = true
+WantScratchMounted   = true

queue task in (abstract_generation_user topic_writing_user)
