# User-LoRA Round 8 — retry for jobs that failed on the initial K=100 submit
# (cluster 174464).
#
# 83/100 jobs failed on the first submit: 75 on tyr1 (CUDA "device busy or
# unavailable" — the known transient GPU-slot oversubscription issue from
# CLAUDE.md/project_cluster_infrastructure, same class as R6's LaMP-4
# retries and this round's own C3' smoke retry on cluster 174463), 7 on modi
# (uncorrectable ECC error — a real hardware fault signal, not just
# scheduling), and 1 (u00008075) was a false failure: refuse-to-overwrite
# against the Step-4 smoke checkpoint already at that output path, which is
# valid and does not need retraining.
#
# This sub retries the 82 genuine failures (83 minus u00008075), excluding
# both tyr1 and modi via requirements. Same recipe/config as
# condor/train_user_lora_lamp3_r8.sub — only the queue list and the
# exclusion requirement differ.
#
# Plan: experiments/2026-07-16-user-lora-round8-lamp3-onelora-plan.md
#
# Submit (after committing this file):
#   condor_submit condor/train_user_lora_lamp3_r8_retry1.sub

universe              = docker
docker_image          = ghcr.io/gordofreemo/smollm3-train:ver4
executable            = train/train.py
arguments             = --config $(config_path)

output                = /home/ange00008/projects/mobileFT_distill/runlogs/train_user_lora_lamp3_r8_retry1.$(ClusterId).$(ProcId).out
error                 = /home/ange00008/projects/mobileFT_distill/runlogs/train_user_lora_lamp3_r8_retry1.$(ClusterId).$(ProcId).err
log                   = /home/ange00008/projects/mobileFT_distill/runlogs/train_user_lora_lamp3_r8_retry1.$(ClusterId).log

should_transfer_files = YES
environment           = "PROJECT_ROOT=/home/ange00008/projects/mobileFT_distill CONDOR_CLUSTER_ID=$(ClusterId) CONDOR_PROC_ID=$(ProcId)"

gpus_minimum_memory     = 32000
gpus_minimum_capability = 8.0
require_gpus            = Capability >= 8.0 && Capability < 10.0

max_job_retirement_time = 28800

stream_output           = true
stream_error            = true
when_to_transfer_output = ON_EXIT_OR_EVICT

request_GPUs          = 1
request_CPUs          = 4
request_memory        = 32G
requirements          = UidDomain == "cs.uni-saarland.de" && Machine != "tyr1.hpc.uni-saarland.de" && Machine != "modi.hpc.uni-saarland.de"
+WantGPUHomeMounted   = true
+WantScratchMounted   = true

# 82 per-user R8 configs that failed on the first submit: 75 on tyr1
# (CUDA-busy oversubscription) + 7 on modi (ECC error). See header above.
queue config_path from (
  /home/ange00008/projects/mobileFT_distill/train/config/user_lora_lamp3_oppu_u00005854_r8.json
