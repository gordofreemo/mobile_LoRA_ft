# Eval-design power analysis: subsample s queries/user from the OPPU
# pairs files, measure detection rate of the already-measured effects.
# CPU-only, scipy via the in-container bootstrap. Generated by
# condor/gen_oppu_subs.py — edit the generator.

universe              = docker
docker_image          = ghcr.io/gordofreemo/smollm3-train:ver4
executable            = /home/ange00008/projects/mobileFT_distill/oppu_replication/run_scoring_in_container.sh
arguments             = /home/ange00008/projects/mobileFT_distill/eval/oppu_power_subsample.py

output                = /home/ange00008/projects/mobileFT_distill/runlogs/oppu_rep_power_subsample.$(ClusterId).$(ProcId).out
error                 = /home/ange00008/projects/mobileFT_distill/runlogs/oppu_rep_power_subsample.$(ClusterId).$(ProcId).err
log                   = /home/ange00008/projects/mobileFT_distill/runlogs/oppu_rep_power_subsample.$(ClusterId).log

should_transfer_files = YES
stream_output           = true
stream_error            = true
when_to_transfer_output = ON_EXIT_OR_EVICT
environment           = "PROJECT_ROOT=/home/ange00008/projects/mobileFT_distill CONDOR_CLUSTER_ID=$(ClusterId) CONDOR_PROC_ID=$(ProcId)"

request_CPUs          = 4
request_memory        = 8G
requirements          = UidDomain == "cs.uni-saarland.de"
+WantGPUHomeMounted   = true

queue 1
