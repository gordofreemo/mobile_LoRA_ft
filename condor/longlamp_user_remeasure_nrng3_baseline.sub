# LongLaMP per-user re-measurement under fixed decoding -- BASELINE arm.
# GENERATED by condor/gen_longlamp_user_remeasure_subs.py -- edit the generator, not this file.
#
# Task adapter alone (no per-user adapter), BM25 k=4, restricted to the 100
# selected users' temporal-test records via --user-records-from-file; one job
# per task, --no-repeat-ngram-size 3. Results land at ..._seed0_nrng3_topK100.json
# alongside the plain-greedy originals. --resume: these are the only
# multi-hour jobs in the round, so a preempted job continues from its own
# predictions file rather than restarting.

universe              = docker
docker_image          = ghcr.io/gordofreemo/smollm3-train:ver4
executable            = eval/eval_longlamp.py

arguments    = --task $(task) --split test --k 4 --seed 0 --adapter /home/ange00008/projects/mobileFT_distill/train/checkpoints/$(adapter_ckpt)/final --base-adapter none --user-records-from-file /home/ange00008/projects/mobileFT_distill/data/longlamp_user_stats/$(top_users) --resume --no-repeat-ngram-size 3

output                = /home/ange00008/projects/mobileFT_distill/runlogs/longlamp_user_remeasure_nrng3_baseline.$(task).$(ClusterId).$(ProcId).out
error                 = /home/ange00008/projects/mobileFT_distill/runlogs/longlamp_user_remeasure_nrng3_baseline.$(task).$(ClusterId).$(ProcId).err
log                   = /home/ange00008/projects/mobileFT_distill/runlogs/longlamp_user_remeasure_nrng3_baseline.$(ClusterId).log

max_job_retirement_time = 7200

should_transfer_files   = YES
when_to_transfer_output = ON_EXIT_OR_EVICT
stream_output           = true
stream_error            = true
environment             = "MODEL_OUT_DIR=/home/ange00008/projects/mobileFT_distill/data/models/SmolLM3-3B LONGLAMP_DIR=/home/ange00008/projects/mobileFT_distill/data/longlamp CONDOR_CLUSTER_ID=$(ClusterId) CONDOR_PROC_ID=$(ProcId)"

gpus_minimum_memory     = 32000
gpus_minimum_capability = 8.0
# Blackwell (sm_120) guard -- ver4's torch 2.5.1+cu124 cannot target it.
require_gpus            = Capability >= 8.0 && Capability < 10.0

request_GPUs          = 1
request_CPUs          = 2
request_memory        = 16G
requirements          = UidDomain == "cs.uni-saarland.de" && Machine != "tyr1.hpc.uni-saarland.de" && Machine != "modi.hpc.uni-saarland.de"
+WantGPUHomeMounted   = true
+WantScratchMounted   = true

queue task, adapter_ckpt, top_users from (
  product_review_temporal, longlamp_lora_review_1ep_seed0, review_top100_users.json
  abstract_generation_temporal, longlamp_lora_abstract_1ep_seed0, abstract_top100_users.json
  topic_writing_temporal, longlamp_lora_topic_1ep_seed0, topic_top100_users.json
)
