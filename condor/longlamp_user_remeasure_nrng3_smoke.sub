# LongLaMP per-user re-measurement under fixed decoding -- SMOKE (run and check before batching)
# GENERATED by condor/gen_longlamp_user_remeasure_subs.py -- edit the generator, not this file.
#
# Personalized arm: task adapter (--base-adapter) + that user's own adapter
# (--adapter), BM25 k=4, temporal test split, --no-repeat-ngram-size 3.
# Results land at ..._seed0_nrng3_user<ID>[_limitN].json -- alongside,
# never over, the plain-greedy originals (no --overwrite anywhere this round).

universe              = docker
docker_image          = ghcr.io/gordofreemo/smollm3-train:ver4
executable            = eval/eval_longlamp.py

# Outer double-quotes = Condor's "new" arguments syntax; single-quotes group
# $(user_id) (may contain spaces) into one argument.
arguments    = "--task $(task) --split test --k 4 --seed 0 --adapter /home/ange00008/projects/mobileFT_distill/train/checkpoints/$(adapter_ckpt)/final --base-adapter /home/ange00008/projects/mobileFT_distill/train/checkpoints/$(base_adapter)/final --user-records '$(user_id)' --no-repeat-ngram-size 3 --limit 2"

output                = /home/ange00008/projects/mobileFT_distill/runlogs/longlamp_user_remeasure_nrng3_smoke.$(task).$(ClusterId).$(ProcId).out
error                 = /home/ange00008/projects/mobileFT_distill/runlogs/longlamp_user_remeasure_nrng3_smoke.$(task).$(ClusterId).$(ProcId).err
log                   = /home/ange00008/projects/mobileFT_distill/runlogs/longlamp_user_remeasure_nrng3_smoke.$(ClusterId).log

max_job_retirement_time = 1800

should_transfer_files   = YES
when_to_transfer_output = ON_EXIT_OR_EVICT
stream_output           = true
stream_error            = true
environment             = "MODEL_OUT_DIR=/home/ange00008/projects/mobileFT_distill/data/models/SmolLM3-3B LONGLAMP_DIR=/home/ange00008/projects/mobileFT_distill/data/longlamp CONDOR_CLUSTER_ID=$(ClusterId) CONDOR_PROC_ID=$(ProcId)"

gpus_minimum_memory     = 32000
gpus_minimum_capability = 8.0
# Blackwell (sm_120) guard -- ver4's torch 2.5.1+cu124 cannot target it.
require_gpus            = Capability >= 8.0 && Capability < 10.0

request_GPUs          = 1
request_CPUs          = 2
request_memory        = 16G
requirements          = UidDomain == "cs.uni-saarland.de" && Machine != "tyr1.hpc.uni-saarland.de" && Machine != "modi.hpc.uni-saarland.de"
+WantGPUHomeMounted   = true
+WantScratchMounted   = true

queue task, base_adapter, adapter_ckpt, user_id from (
  product_review_temporal, longlamp_lora_review_1ep_seed0, longlamp_user_lora_review_A3HU0B9XUEVHIM_seed0, A3HU0B9XUEVHIM
  abstract_generation_temporal, longlamp_lora_abstract_1ep_seed0, longlamp_user_lora_abstract_Lei_Zhang_seed0, Lei Zhang
  topic_writing_temporal, longlamp_lora_topic_1ep_seed0, longlamp_user_lora_topic_IrrelevantTLDR_seed0, IrrelevantTLDR
)
