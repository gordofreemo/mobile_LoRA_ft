# LongLaMP LL1-LL3 re-measurement under fixed decoding -- GENERATED by
# condor/gen_longlamp_remeasure_subs.py. Edit the generator, not this file.
#
# Branch A step 2. All three arms (floor / BM25 baseline / Task-LoRA) x three
# tasks, full test split, identical decoding: --no-repeat-ngram-size 3.
# No retraining -- every adapter is already on disk.
#
# The point of re-running the floor and baseline arms, which did NOT visibly
# degenerate, is that a Task-LoRA number measured with the fix against a
# baseline measured without it is not a comparison. Read the delta only from
# the re-measured table.
#
# Results land at ..._seed0_nrng3.json, alongside (not over) the
# existing plain-greedy files -- refuse-to-overwrite stays intact and the
# original LL1-LL3 numbers remain on disk for the before/after table.
#
# After it finishes:
#   python eval/longlamp_length_check.py results/LongLaMP_*_test_*_nrng3.predictions.jsonl

universe              = docker
docker_image          = ghcr.io/gordofreemo/smollm3-train:ver4
executable            = eval/eval_longlamp.py

arguments             = --task $(task) --split test --seed 0 --resume --adapter $(adapter) $(profile_args) --no-repeat-ngram-size 3

output                = /home/ange00008/projects/mobileFT_distill/runlogs/longlamp_remeasure.$(task).$(arm).$(ClusterId).$(ProcId).out
error                 = /home/ange00008/projects/mobileFT_distill/runlogs/longlamp_remeasure.$(task).$(arm).$(ClusterId).$(ProcId).err
log                   = /home/ange00008/projects/mobileFT_distill/runlogs/longlamp_remeasure.$(ClusterId).log

should_transfer_files   = YES
when_to_transfer_output = ON_EXIT_OR_EVICT
stream_output           = true
stream_error            = true
environment             = "MODEL_OUT_DIR=/home/ange00008/projects/mobileFT_distill/data/models/SmolLM3-3B LONGLAMP_DIR=/home/ange00008/projects/mobileFT_distill/data/longlamp CONDOR_CLUSTER_ID=$(ClusterId) CONDOR_PROC_ID=$(ProcId)"

gpus_minimum_memory     = 32000
gpus_minimum_capability = 8.0
# Blackwell (sm_120) guard -- ver4's torch 2.5.1+cu124 cannot target it.
require_gpus            = Capability >= 8.0 && Capability < 10.0
# Full test splits (1822 / 4560 / 2452 records). --resume is on, so a preempted
# job continues from its own predictions file rather than restarting.
max_job_retirement_time = 600

request_GPUs          = 1
request_CPUs          = 2
request_memory        = 16G
requirements          = UidDomain == "cs.uni-saarland.de" && Machine != "tyr1.hpc.uni-saarland.de" && Machine != "modi.hpc.uni-saarland.de"
+WantGPUHomeMounted   = true
+WantScratchMounted   = true

queue task,adapter,arm,profile_args from (
  product_review_user, none, floor, --no-profile
  product_review_user, none, baseline, --k 4
  product_review_user, /home/ange00008/projects/mobileFT_distill/train/checkpoints/longlamp_lora_review_1ep_seed0/final, tasklora, --k 4
  abstract_generation_user, none, floor, --no-profile
  abstract_generation_user, none, baseline, --k 4
  abstract_generation_user, /home/ange00008/projects/mobileFT_distill/train/checkpoints/longlamp_lora_abstract_1ep_seed0/final, tasklora, --k 4
  topic_writing_user, none, floor, --no-profile
  topic_writing_user, none, baseline, --k 4
  topic_writing_user, /home/ange00008/projects/mobileFT_distill/train/checkpoints/longlamp_lora_topic_1ep_seed0/final, tasklora, --k 4
)
