# LaMP eval — PT1, C3''' arm (Per-Task-LoRA(LaMP-3) + User-LoRA-PT1 stacked
# + BM25), 100 parallel GPU procs (one per user's distinct trained adapter).
#
# Delta over condor/eval_lamp_user_lamp3_r8.sub: base_adapter is
# Per-Task-LoRA(LaMP-3) (per_task_lamp3_1ep_seed0/final) instead of One-LoRA
# FT; adapter paths point at the _ptl_seed0 checkpoints from
# condor/train_user_lora_lamp3_ptl.sub.
#
# Per the PT1 plan §Execution sequence Step 10.
#
# Smoke passed 2026-07-26 (single-user restricted run, cluster 177663):
# accuracy=1.0 on u00008075, correctly loading base + Per-Task-LoRA(LaMP-3)
# + User-LoRA-PT1 stacked, after fixing a missing LAMP_DIR override.
#
# tyr1/modi excluded — same known oversubscription/ECC pattern R8 hit.
#
# Acceptance: 100 result JSON + predictions JSONL pairs; each predictions
# file has exactly 1 line matching that user's test_record_id.
#
# Plan: experiments/2026-07-25-per-task-lora-pt1-lamp3-pilot-plan.md
#
# Submit (after committing this file, and after the K=100 training batch
# (cluster 177679) finishes):
#   condor_submit condor/eval_lamp_user_lamp3_ptl.sub

universe              = docker
docker_image          = ghcr.io/gordofreemo/smollm3-train:ver4
executable            = eval/eval_lamp.py

adapter      = none
user_fp      = u00000000

arguments    = --task LaMP_3 --split test --k 4 --seed 0 --adapter $(adapter) --base-adapter /home/ange00008/projects/mobileFT_distill/train/checkpoints/per_task_lamp3_1ep_seed0/final --user-records $(user_fp)

output                = /home/ange00008/projects/mobileFT_distill/runlogs/eval_lamp_user_lamp3_ptl.$(ClusterId).$(ProcId).out
error                 = /home/ange00008/projects/mobileFT_distill/runlogs/eval_lamp_user_lamp3_ptl.$(ClusterId).$(ProcId).err
log                   = /home/ange00008/projects/mobileFT_distill/runlogs/eval_lamp_user_lamp3_ptl.$(ClusterId).log

should_transfer_files = YES
environment           = "MODEL_OUT_DIR=/home/ange00008/projects/mobileFT_distill/data/models/SmolLM3-3B LAMP_DIR=/home/ange00008/projects/mobileFT_distill/data/lamp_time CONDOR_CLUSTER_ID=$(ClusterId) CONDOR_PROC_ID=$(ProcId)"

max_job_retirement_time = 600
when_to_transfer_output = ON_EXIT_OR_EVICT
stream_output           = true
stream_error            = true

gpus_minimum_memory     = 32000
gpus_minimum_capability = 8.0
require_gpus            = Capability >= 8.0 && Capability < 10.0

request_GPUs          = 1
request_CPUs          = 2
request_memory        = 16G
requirements          = UidDomain == "cs.uni-saarland.de" && Machine != "tyr1.hpc.uni-saarland.de" && Machine != "modi.hpc.uni-saarland.de"
+WantGPUHomeMounted   = true
+WantScratchMounted   = true

# 100 (adapter, user_fp) rows, one per user's distinct PT1 checkpoint.
# Ordered to match data/lamp_user_stats/LaMP_3_top100_users.json. Absolute
# paths required.
