# Paired comparison — User-LoRA Round 8 (LaMP-3 re-run on One-LoRA FT).
#
# CPU-only job. Runs eval/paired_compare.py UNMODIFIED on the consolidated
# C2' vs C3' prediction files:
#   pred-a: results/LaMP_3_test_a2_lamp_1ep_seed0_final_bm25k4_seed0_topK100.predictions.jsonl  (100 lines, C2' batch)
#   pred-b: results/LaMP_3_test_round8_C3.predictions.jsonl  (100 lines, C3' aggregated)
#
# NO pre-registered gate this round (plan axis 10) — paired_compare.py still
# emits p-values/CI/wins-ties-losses as always, they're just reported
# side-by-side with R5's archived Δ−0.050 (7/91/2), not used for a
# pass/fail decision. This is a robustness check on Q4, not a re-litigation
# — Phase 2 stays closed either way.
#
# Plan reference: experiments/2026-07-16-user-lora-round8-lamp3-onelora-plan.md
# §Execution sequence Step 10 / Scaffolding inventory item 8.
#
# Submit (or run directly — CPU-only, sub-second):
#   condor_submit condor/paired_compare_lamp3_r8.sub

universe              = docker
docker_image          = ghcr.io/gordofreemo/smollm3-train:ver4
executable            = eval/paired_compare.py

arguments = --pred-a /home/ange00008/projects/mobileFT_distill/results/LaMP_3_test_a2_lamp_1ep_seed0_final_bm25k4_seed0_topK100.predictions.jsonl --pred-b /home/ange00008/projects/mobileFT_distill/results/LaMP_3_test_round8_C3.predictions.jsonl --label-a c2_onelora_bm25 --label-b c3_onelora_userlora_bm25 --task LaMP_3 --split test --metric mae --seed 0

output                = /home/ange00008/projects/mobileFT_distill/runlogs/paired_compare_lamp3_r8.$(ClusterId).$(ProcId).out
error                 = /home/ange00008/projects/mobileFT_distill/runlogs/paired_compare_lamp3_r8.$(ClusterId).$(ProcId).err
log                   = /home/ange00008/projects/mobileFT_distill/runlogs/paired_compare_lamp3_r8.$(ClusterId).log

should_transfer_files = YES
environment           = "PROJECT_ROOT=/home/ange00008/projects/mobileFT_distill CONDOR_CLUSTER_ID=$(ClusterId) CONDOR_PROC_ID=$(ProcId)"

request_GPUs          = 0
request_CPUs          = 1
request_memory        = 2G

max_job_retirement_time = 600
when_to_transfer_output = ON_EXIT_OR_EVICT
stream_output           = true
stream_error            = true

requirements          = UidDomain == "cs.uni-saarland.de"
+WantGPUHomeMounted   = true
+WantScratchMounted   = true

queue 1
