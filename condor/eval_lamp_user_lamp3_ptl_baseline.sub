# LaMP eval — PT1, C2''' arm (Per-Task-LoRA(LaMP-3) + BM25, no User-LoRA),
# full K=100 batch job. C2''' is user-invariant (same model for all 100
# users), so this runs as ONE job via --user-records-from-file — same
# mechanism as R8's C2' baseline.
#
# Per the PT1 plan §Execution sequence Step 9 / axis 9.
#
# Smoke passed 2026-07-26 (single-user restricted run, cluster 177663):
# accuracy=1.0 on u00008075's test record, after fixing a missing LAMP_DIR
# override that had caused a first attempt (cluster 177653) to match 0/2500
# records.
#
# tyr1/modi excluded — same known oversubscription/ECC pattern R8 hit on its
# K=100 training submit.
#
# Acceptance: results/LaMP_3_test_per_task_lamp3_1ep_seed0_final_bm25k4_seed0_topK100.{json,predictions.jsonl}
# present; predictions file has exactly 100 lines, one per pool user's
# test_record_id.
#
# Plan: experiments/2026-07-25-per-task-lora-pt1-lamp3-pilot-plan.md
#
# Submit (after committing this file):
#   condor_submit condor/eval_lamp_user_lamp3_ptl_baseline.sub

universe              = docker
docker_image          = ghcr.io/gordofreemo/smollm3-train:ver4
executable            = eval/eval_lamp.py

arguments    = --task LaMP_3 --split test --k 4 --seed 0 --adapter /home/ange00008/projects/mobileFT_distill/train/checkpoints/per_task_lamp3_1ep_seed0/final --base-adapter none --user-records-from-file /home/ange00008/projects/mobileFT_distill/data/lamp_user_stats/LaMP_3_top100_users.json --resume

output                = /home/ange00008/projects/mobileFT_distill/runlogs/eval_lamp_user_lamp3_ptl_baseline.$(ClusterId).$(ProcId).out
error                 = /home/ange00008/projects/mobileFT_distill/runlogs/eval_lamp_user_lamp3_ptl_baseline.$(ClusterId).$(ProcId).err
log                   = /home/ange00008/projects/mobileFT_distill/runlogs/eval_lamp_user_lamp3_ptl_baseline.$(ClusterId).log

should_transfer_files = YES
environment           = "MODEL_OUT_DIR=/home/ange00008/projects/mobileFT_distill/data/models/SmolLM3-3B LAMP_DIR=/home/ange00008/projects/mobileFT_distill/data/lamp_time CONDOR_CLUSTER_ID=$(ClusterId) CONDOR_PROC_ID=$(ProcId)"

max_job_retirement_time = 1800
when_to_transfer_output = ON_EXIT_OR_EVICT
stream_output           = true
stream_error            = true

gpus_minimum_memory     = 32000
gpus_minimum_capability = 8.0
require_gpus            = Capability >= 8.0 && Capability < 10.0

request_GPUs          = 1
request_CPUs          = 4
request_memory        = 32G
requirements          = UidDomain == "cs.uni-saarland.de" && Machine != "tyr1.hpc.uni-saarland.de" && Machine != "modi.hpc.uni-saarland.de"
+WantGPUHomeMounted   = true
+WantScratchMounted   = true

queue 1
