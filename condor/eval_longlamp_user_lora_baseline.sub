# LongLaMP eval -- LL4-LL6 baseline arm (Task-LoRA + BM25, no User-LoRA),
# K=100 batch job PER TASK (3 jobs total, one per task).
#
# The baseline model is user-invariant per task, so this runs as ONE job per
# task via --user-records-from-file (mirrors LaMP's R8/PT1 optimization --
# condor/eval_lamp_user_lamp3_r8_baseline.sub) instead of 100 separate
# per-user baseline jobs. Uses each task's `_temporal` split (NOT `_user`) --
# eval must run on the same held-out records the personalized arm evaluates,
# which come from data/longlamp_user_stats/<tag>_top100_users.json's
# test_record_ids (indices into the `_temporal` split's test.json).
#
# Plan: experiments/2026-07-27-longlamp-user-lora-ll4-ll6-plan.md, Execution
# Step 6, decision #10.
#
# REQUIRES condor/longlamp_user_stats.sub to have completed (the 3
# <tag>_top100_users.json files on disk).
#
# Smoke first, one task (per-record --limit smoke, or restrict via a
# hand-built 1-user top-K file):
#   condor_submit -i condor/interactive.sub
#   cd /home/ange00008/projects/mobileFT_distill
#   python eval/eval_longlamp.py --task product_review_temporal --split test --adapter train/checkpoints/longlamp_lora_review_1ep_seed0/final --base-adapter none --user-records-from-file data/longlamp_user_stats/review_top100_users.json --limit 5
#
# Submit (after committing this file, and after longlamp_user_stats.sub has
# produced all 3 top100 JSONs):
#   condor_submit condor/eval_longlamp_user_lora_baseline.sub

universe              = docker
docker_image          = ghcr.io/gordofreemo/smollm3-train:ver4
executable            = eval/eval_longlamp.py

task         = product_review_temporal
adapter_ckpt = longlamp_lora_review_1ep_seed0
top_users    = review_top100_users.json

arguments    = --task $(task) --split test --k 4 --seed 0 --adapter /home/ange00008/projects/mobileFT_distill/train/checkpoints/$(adapter_ckpt)/final --base-adapter none --user-records-from-file /home/ange00008/projects/mobileFT_distill/data/longlamp_user_stats/$(top_users) --resume

output                = /home/ange00008/projects/mobileFT_distill/runlogs/eval_longlamp_user_lora_baseline.$(task).$(ClusterId).$(ProcId).out
error                 = /home/ange00008/projects/mobileFT_distill/runlogs/eval_longlamp_user_lora_baseline.$(task).$(ClusterId).$(ProcId).err
log                   = /home/ange00008/projects/mobileFT_distill/runlogs/eval_longlamp_user_lora_baseline.$(ClusterId).log

should_transfer_files = YES
environment           = "MODEL_OUT_DIR=/home/ange00008/projects/mobileFT_distill/data/models/SmolLM3-3B LONGLAMP_DIR=/home/ange00008/projects/mobileFT_distill/data/longlamp CONDOR_CLUSTER_ID=$(ClusterId) CONDOR_PROC_ID=$(ProcId)"

max_job_retirement_time = 7200
when_to_transfer_output = ON_EXIT_OR_EVICT
stream_output           = true
stream_error            = true

gpus_minimum_memory     = 32000
gpus_minimum_capability = 8.0
require_gpus            = Capability >= 8.0 && Capability < 10.0

request_GPUs          = 1
request_CPUs          = 4
request_memory        = 32G
requirements          = UidDomain == "cs.uni-saarland.de"
+WantGPUHomeMounted   = true
+WantScratchMounted   = true

# One row per task -- baseline is user-invariant, so K=100's worth of test
# records are covered by a single --user-records-from-file job per task.
queue task, adapter_ckpt, top_users from (
  product_review_temporal, longlamp_lora_review_1ep_seed0, review_top100_users.json
  abstract_generation_temporal, longlamp_lora_abstract_1ep_seed0, abstract_top100_users.json
  topic_writing_temporal, longlamp_lora_topic_1ep_seed0, topic_top100_users.json
)
