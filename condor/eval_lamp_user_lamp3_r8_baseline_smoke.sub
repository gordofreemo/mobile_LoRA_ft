# LaMP eval — Round 8 SMOKE, C2' arm (One-LoRA FT + BM25, no User-LoRA) on
# u00008075 only. Exercises the same code path as the full K=100 batch job
# (condor/eval_lamp_user_lamp3_r8_baseline.sub) but restricted via
# --user-records to a single user instead of --user-records-from-file, so it
# stays a true single-record smoke rather than running the whole K=100 batch.
#
# Per the Round-8 plan §Execution sequence Step 5.
#
# Acceptance: clean single-record prediction, no errors, adapter resolves to
# a2_lamp_1ep_seed0/final with base-adapter none.
#
# Submit (after committing this file):
#   condor_submit condor/eval_lamp_user_lamp3_r8_baseline_smoke.sub

universe              = docker
docker_image          = ghcr.io/gordofreemo/smollm3-train:ver4
executable            = eval/eval_lamp.py

arguments    = --task LaMP_3 --split test --k 4 --seed 0 --adapter /home/ange00008/projects/mobileFT_distill/train/checkpoints/a2_lamp_1ep_seed0/final --base-adapter none --user-records u00008075

output                = /home/ange00008/projects/mobileFT_distill/runlogs/eval_lamp_user_lamp3_r8_baseline_smoke.$(ClusterId).$(ProcId).out
error                 = /home/ange00008/projects/mobileFT_distill/runlogs/eval_lamp_user_lamp3_r8_baseline_smoke.$(ClusterId).$(ProcId).err
log                   = /home/ange00008/projects/mobileFT_distill/runlogs/eval_lamp_user_lamp3_r8_baseline_smoke.$(ClusterId).log

should_transfer_files = YES
environment           = "MODEL_OUT_DIR=/home/ange00008/projects/mobileFT_distill/data/models/SmolLM3-3B LAMP_DIR=/home/ange00008/projects/mobileFT_distill/data/lamp_time CONDOR_CLUSTER_ID=$(ClusterId) CONDOR_PROC_ID=$(ProcId)"

max_job_retirement_time = 600
when_to_transfer_output = ON_EXIT_OR_EVICT
stream_output           = true
stream_error            = true

gpus_minimum_memory     = 32000
gpus_minimum_capability = 8.0
require_gpus            = Capability >= 8.0 && Capability < 10.0

request_GPUs          = 1
request_CPUs          = 2
request_memory        = 16G
requirements          = UidDomain == "cs.uni-saarland.de"
+WantGPUHomeMounted   = true
+WantScratchMounted   = true

queue 1
