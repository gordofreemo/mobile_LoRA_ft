# LongLaMP task download — one-time CPU job, one proc per task.
#
# Pulls a LongLaMP/LongLaMP config's train/val/test splits via the HF
# `datasets` library and writes local JSON files under data/longlamp/<task>/.
# See data/download_longlamp.py.
#
# product_review_user (LL1) is already downloaded -- this queue list covers
# only the two new tasks (LL2 Abstract Generation, LL3 Topic Writing). To
# re-run product_review_user, override at submit time:
#   condor_submit -a 'task=product_review_user' condor/download_longlamp.sub
#
# Smoke first if you want:
#   condor_submit -i condor/interactive.sub
#   cd /home/ange00008/projects/mobileFT_distill
#   python data/download_longlamp.py --task abstract_generation_user --limit 20
# Then submit for the real downloads:
#   condor_submit condor/download_longlamp.sub

universe              = docker
docker_image          = ghcr.io/gordofreemo/smollm3-train:ver4
executable            = data/download_longlamp.py
# --out-dir passed explicitly (absolute path) rather than relying on the
# script's own Path(__file__)-relative default -- __file__ resolves inside
# Condor's ephemeral sandbox copy of the executable, not the real repo path,
# so the unqualified default silently wrote LL2/LL3's first download attempt
# into a scratch dir that never made it back (cluster 177628; caught by
# checking data/longlamp/ on disk after the job reported success).
arguments             = --task $(task) --out-dir /home/ange00008/projects/mobileFT_distill/data/longlamp/$(task)

output                = /home/ange00008/projects/mobileFT_distill/runlogs/download_longlamp.$(task).$(ClusterId).$(ProcId).out
error                 = /home/ange00008/projects/mobileFT_distill/runlogs/download_longlamp.$(task).$(ClusterId).$(ProcId).err
log                   = /home/ange00008/projects/mobileFT_distill/runlogs/download_longlamp.$(ClusterId).log

should_transfer_files = YES
environment           = "CONDOR_CLUSTER_ID=$(ClusterId) CONDOR_PROC_ID=$(ProcId)"

# CPU-only — no GPU needed for an HF dataset download.
request_CPUs          = 2
request_memory        = 8G
request_disk           = 4G
requirements          = UidDomain == "cs.uni-saarland.de"
+WantGPUHomeMounted   = true
+WantScratchMounted   = true

queue task in (abstract_generation_user topic_writing_user)
