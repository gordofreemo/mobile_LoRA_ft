# LongLaMP Product Review (user split) download — one-time CPU job.
#
# Pulls LongLaMP/LongLaMP config product_review_user (train/validation/test)
# via the HF `datasets` library and writes local JSON files under
# data/longlamp/product_review_user/. See data/download_longlamp.py and
# experiments/2026-07-17-longlamp-review-ll1-plan.md (Step 2).
#
# Smoke first if you want:
#   condor_submit -i condor/interactive.sub
#   cd /home/ange00008/projects/mobileFT_distill
#   python data/download_longlamp.py --limit 20
# Then submit for the real download:
#   condor_submit condor/download_longlamp.sub

universe              = docker
docker_image          = ghcr.io/gordofreemo/smollm3-train:ver4
executable            = data/download_longlamp.py

output                = /home/ange00008/projects/mobileFT_distill/runlogs/download_longlamp.$(ClusterId).$(ProcId).out
error                 = /home/ange00008/projects/mobileFT_distill/runlogs/download_longlamp.$(ClusterId).$(ProcId).err
log                   = /home/ange00008/projects/mobileFT_distill/runlogs/download_longlamp.$(ClusterId).log

should_transfer_files = YES
environment           = "LONGLAMP_OUT_DIR=/home/ange00008/projects/mobileFT_distill/data/longlamp/product_review_user CONDOR_CLUSTER_ID=$(ClusterId) CONDOR_PROC_ID=$(ProcId)"

# CPU-only — no GPU needed for an HF dataset download.
request_CPUs          = 2
request_memory        = 8G
request_disk           = 4G
requirements          = UidDomain == "cs.uni-saarland.de"
+WantGPUHomeMounted   = true
+WantScratchMounted   = true

queue 1
