# Pool selection for LaMP_7 (K=100).
#
# Streams LaMP_7/test_questions.json, ranks eligible users by
# profile size, writes data/lamp_user_stats/LaMP_7_top100_users.json.
#
# CPU-only. Streaming read + a small in-memory eligibility set.
#
# GENERATED by condor/gen_newtask_subs.py — edit that script and
# regenerate rather than hand-editing this file, or the next
# regeneration will silently drop your change.
#
# Submit (after committing this file):
#   condor_submit condor/select_top_users_lamp7.sub

universe              = docker
docker_image          = ghcr.io/gordofreemo/smollm3-train:ver4
executable            = data/select_top_users_newtasks.py
arguments             = --task LaMP_7

output                = /home/ange00008/projects/mobileFT_distill/runlogs/select_top_users_lamp7.$(ClusterId).$(ProcId).out
error                 = /home/ange00008/projects/mobileFT_distill/runlogs/select_top_users_lamp7.$(ClusterId).$(ProcId).err
log                   = /home/ange00008/projects/mobileFT_distill/runlogs/select_top_users_lamp7.$(ClusterId).log

should_transfer_files = YES
environment           = "PROJECT_ROOT=/home/ange00008/projects/mobileFT_distill LAMP_DIR=/home/ange00008/projects/mobileFT_distill/data/lamp_time CONDOR_CLUSTER_ID=$(ClusterId) CONDOR_PROC_ID=$(ProcId)"

request_CPUs          = 2
request_memory        = 8G
request_disk          = 2G
requirements          = UidDomain == "cs.uni-saarland.de"
+WantGPUHomeMounted   = true
+WantScratchMounted   = true

queue 1
