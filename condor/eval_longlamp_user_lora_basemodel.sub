# LongLaMP eval -- base model (NO adapter at all, no Task-LoRA, no
# User-LoRA) + BM25 profile, restricted to the same K=100-per-task test
# records the LL4-LL6 baseline/personalized arms use. Gives a real
# same-population 3-way comparison (base model -> Task-LoRA -> +User-LoRA)
# instead of mixing the full-test-set base-model number with the K=100
# subset's Task-LoRA/personalized numbers.
#
# Mirrors condor/eval_longlamp_user_lora_baseline.sub exactly, minus the
# Task-LoRA (--adapter none --base-adapter none instead of the Task-LoRA
# checkpoint). Base model is user-invariant per task, so one batch job per
# task via --user-records-from-file.
#
# REQUIRES condor/longlamp_user_stats.sub to have completed (the 3
# <tag>_top100_users.json files on disk).
#
# Submit:
#   condor_submit condor/eval_longlamp_user_lora_basemodel.sub

universe              = docker
docker_image          = ghcr.io/gordofreemo/smollm3-train:ver4
executable            = eval/eval_longlamp.py

task         = product_review_temporal
top_users    = review_top100_users.json

arguments    = --task $(task) --split test --k 4 --seed 0 --adapter none --base-adapter none --user-records-from-file /home/ange00008/projects/mobileFT_distill/data/longlamp_user_stats/$(top_users) --resume

output                = /home/ange00008/projects/mobileFT_distill/runlogs/eval_longlamp_user_lora_basemodel.$(task).$(ClusterId).$(ProcId).out
error                 = /home/ange00008/projects/mobileFT_distill/runlogs/eval_longlamp_user_lora_basemodel.$(task).$(ClusterId).$(ProcId).err
log                   = /home/ange00008/projects/mobileFT_distill/runlogs/eval_longlamp_user_lora_basemodel.$(ClusterId).log

should_transfer_files = YES
environment           = "MODEL_OUT_DIR=/home/ange00008/projects/mobileFT_distill/data/models/SmolLM3-3B LONGLAMP_DIR=/home/ange00008/projects/mobileFT_distill/data/longlamp CONDOR_CLUSTER_ID=$(ClusterId) CONDOR_PROC_ID=$(ProcId)"

max_job_retirement_time = 7200
when_to_transfer_output = ON_EXIT_OR_EVICT
stream_output           = true
stream_error            = true

gpus_minimum_memory     = 32000
gpus_minimum_capability = 8.0
require_gpus            = Capability >= 8.0 && Capability < 10.0

request_GPUs          = 1
request_CPUs          = 4
request_memory        = 32G
requirements          = UidDomain == "cs.uni-saarland.de"
+WantGPUHomeMounted   = true
+WantScratchMounted   = true

queue task, top_users from (
  product_review_temporal, review_top100_users.json
  abstract_generation_temporal, abstract_top100_users.json
  topic_writing_temporal, topic_top100_users.json
)
