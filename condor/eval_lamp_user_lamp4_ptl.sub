# LaMP eval -- PT2, 100 users x {C2-PT2, C3-PT2} on the LaMP-4 time-split.
#
# 200 parallel GPU procs (mirrors condor/eval_lamp_user_lamp4_multi.sub's
# structure exactly, since LaMP-4 users have 1-25 test records each --
# unlike LaMP-3, PT2 cannot use PT1's single-job --user-records-from-file
# shortcut, which only pulls one test_record_id per user):
#
#   C2-PT2 (Per-Task-LoRA(LaMP-4) + BM25, no User-LoRA):
#       adapter      = per_task_lamp4_1ep_seed0/final
#       base_adapter = none
#       Reproduces the per-user baseline on each user's LaMP_4 test records.
#       Model is user-invariant; run per-user anyway (same as R6's C2) so
#       results land in per-user files with the same n_test line count as C3.
#
#   C3-PT2 (Per-Task-LoRA(LaMP-4) + User-LoRA-PT2 + BM25, stacked):
#       adapter      = user_lora_lamp4_<user>_ptl_seed0/final  (condor/train_user_lora_lamp4_ptl.sub output)
#       base_adapter = per_task_lamp4_1ep_seed0/final
#
# Both conditions use --user-records <fp> to pin eval to that user's LaMP_4
# test records, per data/lamp_user_stats/LaMP_4_user_records.json.
#
# eval_lamp.py refuses to overwrite by default, so re-submits after partial
# sweeps only re-run the missing combinations.
#
# tyr1/modi excluded -- known oversubscription/ECC pattern hit by R8/PT1.
#
# Run the smoke sub (condor/eval_lamp_user_lamp4_ptl_smoke.sub) first, and
# only after the K=100 training batch (condor/train_user_lora_lamp4_ptl.sub)
# has produced all 100 adapters.
#
# Submit (after committing this file):
#   condor_submit condor/eval_lamp_user_lamp4_ptl.sub

universe              = docker
docker_image          = ghcr.io/gordofreemo/smollm3-train:ver4
executable            = eval/eval_lamp.py

# Macros driven by the queue block. eval_lamp.py treats "none" as "no adapter".
adapter      = none
base_adapter = none
user_fp      = u00000000

arguments    = --task LaMP_4 --split test --k 4 --seed 0 --adapter $(adapter) --base-adapter $(base_adapter) --user-records $(user_fp)

output                = /home/ange00008/projects/mobileFT_distill/runlogs/eval_lamp_user_lamp4_ptl.$(ClusterId).$(ProcId).out
error                 = /home/ange00008/projects/mobileFT_distill/runlogs/eval_lamp_user_lamp4_ptl.$(ClusterId).$(ProcId).err
log                   = /home/ange00008/projects/mobileFT_distill/runlogs/eval_lamp_user_lamp4_ptl.$(ClusterId).log

should_transfer_files = YES
environment           = "MODEL_OUT_DIR=/home/ange00008/projects/mobileFT_distill/data/models/SmolLM3-3B LAMP_DIR=/home/ange00008/projects/mobileFT_distill/data/lamp_time CONDOR_CLUSTER_ID=$(ClusterId) CONDOR_PROC_ID=$(ProcId)"

max_job_retirement_time = 600
when_to_transfer_output = ON_EXIT_OR_EVICT
stream_output           = true
stream_error            = true

gpus_minimum_memory     = 32000
gpus_minimum_capability = 8.0
require_gpus            = Capability >= 8.0 && Capability < 10.0

request_GPUs          = 1
request_CPUs          = 2
request_memory        = 16G
requirements          = UidDomain == "cs.uni-saarland.de" && Machine != "tyr1.hpc.uni-saarland.de" && Machine != "modi.hpc.uni-saarland.de"
+WantGPUHomeMounted   = true
+WantScratchMounted   = true

# 200 (adapter, base_adapter, user_fp) rows: 100 C2-PT2 (Per-Task-LoRA(LaMP-4)
# alone) then 100 C3-PT2 (User-LoRA-PT2 stacked). Ordered to match the
# canonical top-100 user ordering from data/lamp_user_stats/LaMP_4_top100_users.json.
