# PT1 — LaMP-3 multi-user training on Per-Task-LoRA(LaMP-3) (K=100 parallel GPU procs).
#
# Each proc reads a per-user OPPU config from train/config/ (generated by
# data/lamp_user_stats/ptl_gen_configs.py from the PT1 template) and trains
# a fresh r=8 q+v-only LoRA on top of Per-Task-LoRA(LaMP-3)
# (train/checkpoints/per_task_lamp3_1ep_seed0/final), stacked via train.py's
# base_adapter plumbing — NOT merged, unchanged from R5's stack-vs-merge
# decision.
#
# Delta over condor/train_user_lora_lamp3_r8.sub: base_adapter is
# Per-Task-LoRA(LaMP-3) instead of One-LoRA FT; every config/output path
# carries a _ptl suffix so R5's and R8's 100 adapters are never touched.
#
# OPPU recipe (pinned, do NOT edit, byte-identical to R5/R8):
#   r=8, lora_alpha=16, target_modules=[q_proj, v_proj], lora_dropout=0.05
#   LR=1e-5, weight_decay=1e-2, 3 epochs, cosine + 3% warmup
#   per_device_batch=2, grad_accum=4 (R5's post-OOM working config)
#   max_seq_length=7168 (R5's T3 sizing, reused unchanged)
#
# Acceptance per user (PT1 plan §Execution sequence Step 8):
#   - train/checkpoints/user_lora_lamp3_<user>_ptl_seed0/final/adapter_config.json
#     with r=8, target_modules=["q_proj", "v_proj"]
#   - train_meta.json with base_adapter_path ending in per_task_lamp3_1ep_seed0/final
#   - non-NaN final loss
#   - All 100 adapters present (or at least 95); surface specifics if 3-5 fail
#
# Smoke (u00008075) passed 2026-07-26: cluster 177648, checkpoint verified,
# base_adapter_path correct, both eval arms confirmed clean after fixing a
# missing LAMP_DIR override (cluster 177663).
#
# Plan: experiments/2026-07-25-per-task-lora-pt1-lamp3-pilot-plan.md
#
# Submit (after committing this file):
#   condor_submit condor/train_user_lora_lamp3_ptl.sub

universe              = docker
docker_image          = ghcr.io/gordofreemo/smollm3-train:ver4
executable            = train/train.py
arguments             = --config $(config_path)

output                = /home/ange00008/projects/mobileFT_distill/runlogs/train_user_lora_lamp3_ptl.$(ClusterId).$(ProcId).out
error                 = /home/ange00008/projects/mobileFT_distill/runlogs/train_user_lora_lamp3_ptl.$(ClusterId).$(ProcId).err
log                   = /home/ange00008/projects/mobileFT_distill/runlogs/train_user_lora_lamp3_ptl.$(ClusterId).log

should_transfer_files = YES
environment           = "PROJECT_ROOT=/home/ange00008/projects/mobileFT_distill CONDOR_CLUSTER_ID=$(ClusterId) CONDOR_PROC_ID=$(ProcId)"

gpus_minimum_memory     = 32000
gpus_minimum_capability = 8.0
require_gpus            = Capability >= 8.0 && Capability < 10.0

max_job_retirement_time = 28800

stream_output           = true
stream_error            = true
when_to_transfer_output = ON_EXIT_OR_EVICT

request_GPUs          = 1
request_CPUs          = 4
request_memory        = 32G
requirements          = UidDomain == "cs.uni-saarland.de" && Machine != "tyr1.hpc.uni-saarland.de" && Machine != "modi.hpc.uni-saarland.de"
+WantGPUHomeMounted   = true
+WantScratchMounted   = true

queue config_path from (
