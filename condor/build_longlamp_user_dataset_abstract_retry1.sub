# Retry sub for 25/300 build_longlamp_user_dataset.sub (cluster 178346)
# failures, all on abstract -- a real bug, now fixed: an id-based
# self-retrieval assertion in train/build_longlamp_user_dataset.py falsely
# crashed on users whose Abstract profile contains two DIFFERENT entries
# sharing the same `id` (confirmed real, e.g. "Jun Li"'s profile has paper
# id 53e99d36b7602d97025eebe5 at two distinct indices -- not a leak, since
# leave-one-out excludes by INDEX, not id). Assertion removed; fix verified
# locally on "Jun Li" (1550/1550 examples written, no crash) before this
# retry sub was written.
#
# Same recipe/config as the main sub -- see condor/build_longlamp_user_dataset.sub
# for full context. This sub exists only to avoid needlessly re-running the
# 275 users that already succeeded.

universe              = docker
docker_image          = ghcr.io/gordofreemo/smollm3-train:ver4
executable            = train/build_longlamp_user_dataset.py
arguments             = "--tag $(tag) --user '$(user_id)' --k 4 --overwrite"

output                = /home/ange00008/projects/mobileFT_distill/runlogs/build_longlamp_user_dataset_retry1.$(tag).$(ClusterId).$(ProcId).out
error                 = /home/ange00008/projects/mobileFT_distill/runlogs/build_longlamp_user_dataset_retry1.$(tag).$(ClusterId).$(ProcId).err
log                   = /home/ange00008/projects/mobileFT_distill/runlogs/build_longlamp_user_dataset_retry1.$(ClusterId).log

should_transfer_files = YES
environment           = "PROJECT_ROOT=/home/ange00008/projects/mobileFT_distill CONDOR_CLUSTER_ID=$(ClusterId) CONDOR_PROC_ID=$(ProcId)"

request_CPUs          = 2
request_memory        = 8G
request_disk          = 2G
requirements          = UidDomain == "cs.uni-saarland.de"
+WantGPUHomeMounted   = true
+WantScratchMounted   = true

queue tag, user_id from (
  abstract, Bin Guo
  abstract, Bin Li
  abstract, Bo Xu
  abstract, Bo Zhang
  abstract, Brian D O Anderson
  abstract, Feng Ding
  abstract, Gang Wang
  abstract, Hermann Ney
  abstract, Hong Jiang
  abstract, Jiawei Han
  abstract, Jiming Chen
  abstract, Jing Chen
  abstract, Jun Li
  abstract, Lei Yu
  abstract, Lei Zhang
  abstract, Liang Zhao
  abstract, Lin Ma
  abstract, Mohammad S Obaidat
  abstract, Qiang Zhou
  abstract, Saharon Shelah
  abstract, Shiguang Shan
  abstract, Xin Chen
  abstract, Yan Shi
  abstract, Yu Cao
  abstract, Zeshui Xu
)
