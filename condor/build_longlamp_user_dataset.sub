# Per-user LongLaMP training-corpus build for the LL4-LL6 User-LoRA round --
# 300 parallel CPU procs (3 tasks x K=100 users).
#
# Each proc invokes train/build_longlamp_user_dataset.py for its assigned
# (tag, user_id), emitting:
#     data/longlamp_user_train_<tag>_<user_tag>_bm25k4.jsonl
#     data/longlamp_user_train_<tag>_<user_tag>_bm25k4.meta.json
#
# Plan: experiments/2026-07-27-longlamp-user-lora-ll4-ll6-plan.md, Execution
# Step 4. Per the REVISED pinned design #8 (profile-entry reframing, /grill_me
# addendum 2026-07-28 -- the original "records" framing turned out non-viable,
# every eligible user had exactly 1 temporal-train record): each user's
# training snapshot (the temporal-TRAIN record with the largest profile,
# `train_snapshot_idx` from data/longlamp_user_stats.py) has its profile
# entries reframed as (input,output) pairs using that task's own template;
# system slot = leave-one-out BM25 top-k over the snapshot's OTHER entries.
#
# REQUIRES, in order: condor/download_longlamp_temporal.sub (data on disk)
# then condor/longlamp_user_stats.sub (<tag>_top100_users.json +
# <tag>_user_records.json on disk, schema_version 2).
#
# Smoke already done locally 2026-07-28/29 for one user per task (review,
# abstract, topic -- smallest-profile-size users, --limit 5/3/3), inspected
# by eye: leave-one-out exclusion confirmed correct, input/output template
# match confirmed exact for review/topic and accepted-gap-only for abstract
# (missing keyword list, per design). Smoke artifacts were local-only and
# deleted after inspection, not committed.
#
# Queue block generated 2026-07-30 via:
#   for t in review abstract topic; do
#     python data/longlamp_user_stats/gen_configs.py --tag $t --print-queue build
#   done
# from data/longlamp_user_stats/{review,abstract,topic}_top100_users.json
# (schema_version 2, post-addendum). Re-generate and replace if those files
# are ever rebuilt with --overwrite.
#
# QUEUE-SYNTAX GOTCHA (found + verified empirically 2026-07-29/30, real bug
# caught before submitting, not guessed): Condor's `queue vars from (...)`
# splits each line on BOTH commas AND whitespace by default -- neither
# single- nor double-quoting a field preserves embedded spaces. Abstract's
# user_ids are author names with spaces (e.g. "Lei Zhang"), which broke an
# earlier 3-field version of this queue (tag, user_id, user_tag) -- "Lei
# Zhang" silently truncated to "Lei". Fixed by (1) dropping the redundant
# user_tag field and (2) making user_id the LAST variable, where Condor's
# parser lets the final variable absorb the remainder of the line verbatim
# (confirmed via a standalone Condor test job that printed real argv).

universe              = docker
docker_image          = ghcr.io/gordofreemo/smollm3-train:ver4
executable            = train/build_longlamp_user_dataset.py
# Outer double-quotes = Condor's "new" arguments syntax; single-quotes group
# a value that may contain spaces ($(user_id), see the queue-syntax gotcha
# above) into one argument.
arguments             = "--tag $(tag) --user '$(user_id)' --k 4 --overwrite"

output                = /home/ange00008/projects/mobileFT_distill/runlogs/build_longlamp_user_dataset.$(tag).$(ClusterId).$(ProcId).out
error                 = /home/ange00008/projects/mobileFT_distill/runlogs/build_longlamp_user_dataset.$(tag).$(ClusterId).$(ProcId).err
log                   = /home/ange00008/projects/mobileFT_distill/runlogs/build_longlamp_user_dataset.$(ClusterId).log

should_transfer_files = YES
environment           = "PROJECT_ROOT=/home/ange00008/projects/mobileFT_distill CONDOR_CLUSTER_ID=$(ClusterId) CONDOR_PROC_ID=$(ProcId)"

# CPU-only -- BM25 over a single record's profile + JSONL write.
request_CPUs          = 2
request_memory        = 8G
request_disk          = 2G
requirements          = UidDomain == "cs.uni-saarland.de"
+WantGPUHomeMounted   = true
+WantScratchMounted   = true

# Format: tag, user_id (user_id MUST be last -- see queue-syntax gotcha
# above). 300 rows = 3 tasks x K=100 users.
