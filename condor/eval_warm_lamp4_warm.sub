# Warm-Start round eval — LaMP_4 WARM arm (100 procs).
#
# --base-adapter is 'none' for this arm ON PURPOSE. The warm adapter
# WAS the Per-Task-LoRA and was continued from it, so supplying the
# Per-Task-LoRA as a base would apply the task delta twice.
#
# No baseline job here — the baseline arm is already on disk and is
# reused byte-identical (100 per-user files).
#
# Result stem: LaMP_4_test_user_lora_lamp4_<user>_warm_seed0_final_bm25k4_seed0_user<user>
#
# LAMP_DIR is set to the TIME-based split below and is load-bearing:
# without it eval_lamp.py silently matches 0 records and still exits
# 0 (the bug PT1's first smoke eval hit). After this runs, check the
# record COUNTS, not just exit codes.
#
# eval_lamp.py refuses to overwrite, so re-submits only fill gaps.
#
# Run condor/eval_warm_lamp4_warm_smoke.sub first, and only after the
# training batch has produced all 100 adapters.
#
# GENERATED by condor/gen_warm_subs.py — edit that script and
# regenerate rather than hand-editing this file, or the next
# regeneration will silently drop your change.
#
# Submit (after committing this file):
#   condor_submit condor/eval_warm_lamp4_warm.sub

universe              = docker
docker_image          = ghcr.io/gordofreemo/smollm3-train:ver4
executable            = eval/eval_lamp.py

# Macros driven by the queue block. eval_lamp.py treats "none" as "no adapter".
adapter      = none
base_adapter = none
user_fp      = u00000000

arguments             = --task LaMP_4 --split test --k 4 --seed 0 --adapter $(adapter) --base-adapter $(base_adapter) --user-records $(user_fp)

output                = /home/ange00008/projects/mobileFT_distill/runlogs/eval_warm_lamp4_warm.$(ClusterId).$(ProcId).out
error                 = /home/ange00008/projects/mobileFT_distill/runlogs/eval_warm_lamp4_warm.$(ClusterId).$(ProcId).err
log                   = /home/ange00008/projects/mobileFT_distill/runlogs/eval_warm_lamp4_warm.$(ClusterId).log

should_transfer_files = YES
environment           = "MODEL_OUT_DIR=/home/ange00008/projects/mobileFT_distill/data/models/SmolLM3-3B LAMP_DIR=/home/ange00008/projects/mobileFT_distill/data/lamp_time CONDOR_CLUSTER_ID=$(ClusterId) CONDOR_PROC_ID=$(ProcId)"

max_job_retirement_time = 600
when_to_transfer_output = ON_EXIT_OR_EVICT
stream_output           = true
stream_error            = true

gpus_minimum_memory     = 32000
gpus_minimum_capability = 8.0
require_gpus            = Capability >= 8.0 && Capability < 10.0

request_GPUs          = 1
request_CPUs          = 2
request_memory        = 16G
requirements          = UidDomain == "cs.uni-saarland.de" && Machine != "tyr1.hpc.uni-saarland.de" && Machine != "modi.hpc.uni-saarland.de"
+WantGPUHomeMounted   = true
+WantScratchMounted   = true

queue adapter, base_adapter, user_fp from (
