# LaMP eval — Round 8, C3' arm (One-LoRA FT + User-LoRA-R8 stacked + BM25),
# 100 parallel GPU procs (one per user's distinct trained adapter).
#
# Delta over condor/eval_lamp_user_lamp3.sub (R5, which combined C2+C3 in
# 200 rows): this sub is C3'-only, 100 rows — R8's C2' arm is user-invariant
# and already ran as a single batch job
# (condor/eval_lamp_user_lamp3_r8_baseline.sub), per plan axis 9. base_adapter
# is One-LoRA FT (a2_lamp_1ep_seed0/final) instead of A1-lamp checkpoint-1000;
# adapter paths point at the _r8_seed0 checkpoints from
# condor/train_user_lora_lamp3_r8.sub + train_user_lora_lamp3_r8_retry1.sub.
#
# Per the Round-8 plan §Execution sequence Step 8.
#
# Smoke passed 2026-07-17 (single-user restricted run, cluster 174463 retry):
# pred='5' gold='5' on u00008075, correctly loading base + One-LoRA FT +
# User-LoRA-R8 stacked.
#
# tyr1 excluded — the K=100 training submit (cluster 174464) hit 75/83
# failures on tyr1 (CUDA-busy oversubscription) when unguarded; same
# precaution already applied to the C2' baseline sub.
#
# Acceptance: 100 result JSON + predictions JSONL pairs; each predictions
# file has exactly 1 line matching that user's test_record_id.
#
# Plan: experiments/2026-07-16-user-lora-round8-lamp3-onelora-plan.md
#
# Submit (after committing this file):
#   condor_submit condor/eval_lamp_user_lamp3_r8.sub

universe              = docker
docker_image          = ghcr.io/gordofreemo/smollm3-train:ver4
executable            = eval/eval_lamp.py

adapter      = none
user_fp      = u00000000

arguments    = --task LaMP_3 --split test --k 4 --seed 0 --adapter $(adapter) --base-adapter /home/ange00008/projects/mobileFT_distill/train/checkpoints/a2_lamp_1ep_seed0/final --user-records $(user_fp)

output                = /home/ange00008/projects/mobileFT_distill/runlogs/eval_lamp_user_lamp3_r8.$(ClusterId).$(ProcId).out
error                 = /home/ange00008/projects/mobileFT_distill/runlogs/eval_lamp_user_lamp3_r8.$(ClusterId).$(ProcId).err
log                   = /home/ange00008/projects/mobileFT_distill/runlogs/eval_lamp_user_lamp3_r8.$(ClusterId).log

should_transfer_files = YES
environment           = "MODEL_OUT_DIR=/home/ange00008/projects/mobileFT_distill/data/models/SmolLM3-3B LAMP_DIR=/home/ange00008/projects/mobileFT_distill/data/lamp_time CONDOR_CLUSTER_ID=$(ClusterId) CONDOR_PROC_ID=$(ProcId)"

max_job_retirement_time = 600
when_to_transfer_output = ON_EXIT_OR_EVICT
stream_output           = true
stream_error            = true

gpus_minimum_memory     = 32000
gpus_minimum_capability = 8.0
require_gpus            = Capability >= 8.0 && Capability < 10.0

request_GPUs          = 1
request_CPUs          = 2
request_memory        = 16G
requirements          = UidDomain == "cs.uni-saarland.de" && Machine != "tyr1.hpc.uni-saarland.de"
+WantGPUHomeMounted   = true
+WantScratchMounted   = true

# 100 (adapter, user_fp) rows, one per user's distinct R8 checkpoint. Ordered
# to match data/lamp_user_stats/LaMP_3_top100_users.json. Absolute paths
