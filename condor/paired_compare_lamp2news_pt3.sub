# PT3 paired comparison — LaMP_2_news, metric=accuracy.
#
# Users hold 3-35 test records each, so this uses the GROUPED
# per-user comparison: per-record scores are averaged within a
# user first, then the paired-t / Wilcoxon / bootstrap battery
# runs over the 27 per-user means — not over records, which
# would over-weight heavy users and break independence.
#
# Descriptive reporting only — no pre-registered gate, matching
# the convention every round since R6.
#
# Run AFTER eval/aggregate_user_predictions_newtask.py has built
# both consolidated prediction files.
#
# GENERATED by condor/gen_newtask_subs.py — edit that script and
# regenerate rather than hand-editing this file, or the next
# regeneration will silently drop your change.
#
# Submit (after committing this file):
#   condor_submit condor/paired_compare_lamp2news_pt3.sub

universe              = docker
docker_image          = ghcr.io/gordofreemo/smollm3-train:ver4
executable            = eval/paired_compare_per_user.py

arguments             = --pred-a /home/ange00008/projects/mobileFT_distill/results/LaMP_2_news_test_pt3_C2.predictions.jsonl --pred-b /home/ange00008/projects/mobileFT_distill/results/LaMP_2_news_test_pt3_C3.predictions.jsonl --label-a c2_pt3_bm25 --label-b c3_pt3_userlora_bm25 --task LaMP_2_news --split test --metric accuracy --round-tag pt3 --seed 0

output                = /home/ange00008/projects/mobileFT_distill/runlogs/paired_compare_lamp2news_pt3.$(ClusterId).$(ProcId).out
error                 = /home/ange00008/projects/mobileFT_distill/runlogs/paired_compare_lamp2news_pt3.$(ClusterId).$(ProcId).err
log                   = /home/ange00008/projects/mobileFT_distill/runlogs/paired_compare_lamp2news_pt3.$(ClusterId).log

should_transfer_files = YES
environment           = "PROJECT_ROOT=/home/ange00008/projects/mobileFT_distill CONDOR_CLUSTER_ID=$(ClusterId) CONDOR_PROC_ID=$(ProcId)"

request_GPUs          = 0
request_CPUs          = 1
request_memory        = 2G

max_job_retirement_time = 600
when_to_transfer_output = ON_EXIT_OR_EVICT
stream_output           = true
stream_error            = true

requirements          = UidDomain == "cs.uni-saarland.de"
+WantGPUHomeMounted   = true
+WantScratchMounted   = true

queue 1
