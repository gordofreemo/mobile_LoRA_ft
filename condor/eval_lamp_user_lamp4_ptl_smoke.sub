# PT2 — smoke eval of both arms (C2-PT2 baseline, C3-PT2 stacked), restricted
# to the one smoke user (u00000070) trained by
# condor/train_user_lora_lamp4_ptl_smoke.sub. Confirms both eval paths work
# before submitting the full K=100 batch (condor/eval_lamp_user_lamp4_ptl.sub).
#
# baseline row: Per-Task-LoRA(LaMP-4) alone (--adapter set, --base-adapter
# none), restricted via --user-records to this one user.
# stacked row: Per-Task-LoRA(LaMP-4) + User-LoRA-PT2 stacked
# (--base-adapter + --adapter), same as a single row of the full C3-PT2
# per-user batch.
#
# Unlike PT1's LaMP-3 smoke, no --limit is used here — LaMP-4's
# --user-records filter already restricts to this one user's small test set
# (<=25 records), and --limit would additionally truncate the underlying
# full split before that filter runs, which isn't needed here.
#
# Submit (after committing this file):
#   condor_submit condor/eval_lamp_user_lamp4_ptl_smoke.sub

universe              = docker
docker_image          = ghcr.io/gordofreemo/smollm3-train:ver4
executable            = eval/eval_lamp.py

output                = /home/ange00008/projects/mobileFT_distill/runlogs/eval_lamp_user_lamp4_ptl_smoke.$(arm).$(ClusterId).$(ProcId).out
error                 = /home/ange00008/projects/mobileFT_distill/runlogs/eval_lamp_user_lamp4_ptl_smoke.$(arm).$(ClusterId).$(ProcId).err
log                   = /home/ange00008/projects/mobileFT_distill/runlogs/eval_lamp_user_lamp4_ptl_smoke.$(ClusterId).log

should_transfer_files = YES
environment           = "MODEL_OUT_DIR=/home/ange00008/projects/mobileFT_distill/data/models/SmolLM3-3B LAMP_DIR=/home/ange00008/projects/mobileFT_distill/data/lamp_time CONDOR_CLUSTER_ID=$(ClusterId) CONDOR_PROC_ID=$(ProcId)"

request_GPUs          = 1
request_CPUs          = 2
request_memory        = 16G
requirements          = UidDomain == "cs.uni-saarland.de" && Machine != "tyr1.hpc.uni-saarland.de" && Machine != "modi.hpc.uni-saarland.de"
require_gpus          = Capability >= 8.0 && Capability < 10.0
+WantGPUHomeMounted   = true
+WantScratchMounted   = true

arguments = --task LaMP_4 --split test --k 4 --seed 0 --adapter /home/ange00008/projects/mobileFT_distill/train/checkpoints/per_task_lamp4_1ep_seed0/final --base-adapter none --user-records u00000070
arm       = baseline
queue 1

arguments = --task LaMP_4 --split test --k 4 --seed 0 --adapter /home/ange00008/projects/mobileFT_distill/train/checkpoints/user_lora_lamp4_u00000070_ptl_seed0/final --base-adapter /home/ange00008/projects/mobileFT_distill/train/checkpoints/per_task_lamp4_1ep_seed0/final --user-records u00000070
arm       = stacked
queue 1
