# Per-user LaMP_1 training corpus build (100 parallel CPU procs).
#
# Emits data/lamp_user_train_LaMP_1_<user>_unsup.jsonl
# (+ .meta.json) for each user in the pinned pool
# data/lamp_user_stats/LaMP_1_top100_users.json.
#
# Framing: --framing unsupervised
#
# This task's users appear in exactly ONE split — none holds both a
# train record and a test record — so build_user_dataset.py sources the
# profile snapshot from the user's own TEST record (documented fallback,
# not leakage: a record's profile is history prior to that record).
#
# build_user_dataset.py refuses to overwrite by default, so a
# re-submit after a partial sweep only fills the gaps. The smoke
# user's file will collide on the full submit — that ONE
# refuse-to-overwrite failure is expected, not a real failure.
#
# GENERATED by condor/gen_newtask_subs.py — edit that script and
# regenerate rather than hand-editing this file, or the next
# regeneration will silently drop your change.
#
# Submit (after committing this file):
#   condor_submit condor/build_user_dataset_lamp1.sub

universe              = docker
docker_image          = ghcr.io/gordofreemo/smollm3-train:ver4
executable            = train/build_user_dataset.py
arguments             = --task LaMP_1 --user $(user) --framing unsupervised

output                = /home/ange00008/projects/mobileFT_distill/runlogs/build_user_dataset_lamp1.$(ClusterId).$(ProcId).out
error                 = /home/ange00008/projects/mobileFT_distill/runlogs/build_user_dataset_lamp1.$(ClusterId).$(ProcId).err
log                   = /home/ange00008/projects/mobileFT_distill/runlogs/build_user_dataset_lamp1.$(ClusterId).log

should_transfer_files = YES
environment           = "PROJECT_ROOT=/home/ange00008/projects/mobileFT_distill LAMP_DIR=/home/ange00008/projects/mobileFT_distill/data/lamp_time CONDOR_CLUSTER_ID=$(ClusterId) CONDOR_PROC_ID=$(ProcId)"

request_CPUs          = 2
request_memory        = 8G
request_disk          = 4G
requirements          = UidDomain == "cs.uni-saarland.de"
+WantGPUHomeMounted   = true
+WantScratchMounted   = true

queue user from (
