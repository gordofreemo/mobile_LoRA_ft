# A2-lamp smoke test — batch (non-interactive) equivalent of running
# `python train/train.py --config train/config/a2_lamp_1ep.json --limit 64 --max_steps 4`
# in an interactive session. --limit/--max_steps make train.py append
# `_limit64_steps4` to output_dir, so this can never collide with the real
# run's train/checkpoints/a2_lamp_1ep_seed0/ (see train.py's refuse-to-
# overwrite + smoke-suffix logic).
#
# Confirms: config loads, the 7-task corpus tokenizes/loads correctly,
# a few optimizer steps run without NaN/crash, a checkpoint gets written.
#
# Submit directly, no interactive session needed:
#   condor_submit condor/train_a2_lamp_smoke.sub
# Then check:
#   cat runlogs/train_a2_lamp_smoke.<cluster>.<proc>.out
#   cat train/checkpoints/a2_lamp_1ep_seed0_limit64_steps4/train_meta.json
#   cat train/checkpoints/a2_lamp_1ep_seed0_limit64_steps4/metrics.jsonl
#
# Once this looks right, submit the real run:
#   condor_submit condor/train_a2_lamp.sub

universe              = docker
docker_image          = ghcr.io/gordofreemo/smollm3-train:ver4
executable            = train/train.py
arguments             = --config train/config/a2_lamp_1ep.json --limit 64 --max_steps 4 --no-wandb

output                = /home/ange00008/projects/mobileFT_distill/runlogs/train_a2_lamp_smoke.$(ClusterId).$(ProcId).out
error                 = /home/ange00008/projects/mobileFT_distill/runlogs/train_a2_lamp_smoke.$(ClusterId).$(ProcId).err
log                   = /home/ange00008/projects/mobileFT_distill/runlogs/train_a2_lamp_smoke.$(ClusterId).log

should_transfer_files = YES
environment           = "PROJECT_ROOT=/home/ange00008/projects/mobileFT_distill CONDOR_CLUSTER_ID=$(ClusterId) CONDOR_PROC_ID=$(ProcId)"

gpus_minimum_memory     = 32000
gpus_minimum_capability = 8.0

stream_output           = true
stream_error            = true
when_to_transfer_output = ON_EXIT_OR_EVICT

request_GPUs          = 1
request_CPUs          = 4
request_memory        = 32G
requirements          = UidDomain == "cs.uni-saarland.de"
+WantGPUHomeMounted   = true
+WantScratchMounted   = true

queue 1
