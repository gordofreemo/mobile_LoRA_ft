+# --- Adapter depth at 4-bit (2026-09-24) -------------------------------------------
+# experiments/2026-09-24-depth-quality-4bit-plan.md. The _r5q4t pipeline (P26 4-bit
+# base, r5 recipe P19) plus P24 --lora-layers N, which adapts the last N of 36 blocks
+# through LoraConfig.layers_to_transform, exactly as depth_user_sub ran _r5d24/_r5d18
+# at 16-bit. Movie tagging only. Tags _r5q4td24 / _r5q4td18 (smoke: ..smoke); no
+# existing tag is written. Scored against the same 4-bit Task arm (_q4) as _r5q4t.
+Q4TDEPTH_ARGS = Q4T_ARGS + " --lora-layers $(depth)"
+_MOVIE_ROW = "movie_tagging {} {}".format(*K0_ROOTS["movie_tagging"])
+
+
+def q4tdepth_smoke_sub():
+    rows = [f"    {_MOVIE_ROW} {d} 0 1\n" for d in DEPTHS]
+    return ("# Adapter depth at 4-bit, SMOKE: movie tagging, user 0, one job per depth.\n"
+            "# Check [P24] layers_to_transform, the q4deq model path and the trainable\n"
+            "# parameter count (N/36 of _r5q4t's 1,916,928), not the exit code.\n"
+            "# Generated by condor/gen_oppu_subs.py — edit the generator.\n\n"
+            + header("oppu_rep_q4tdepth_smoke_d$(depth)",
+                     f"{ROOT}/oppu_replication/run_oppu.py",
+                     Q4TDEPTH_ARGS.replace("$(rtag)", "_r5q4td$(depth)smoke"))
+            + "priority              = 5\n"
+            + "\nqueue task, rootname, promptrel, depth, ustart, uend from (\n" + "".join(rows) + ")\n")
+
+
+def q4tdepth_user_sub():
+    n = dict(TASKS)["movie_tagging"]
+    rows = [f"    {_MOVIE_ROW} {d} {s} {min(s + USERS_PER_SHARD, n)}\n"
+            for d in DEPTHS for s in range(0, n, USERS_PER_SHARD)]
+    return (f"# Adapter depth at 4-bit: movie tagging, depths {', '.join(str(d) for d in DEPTHS)},\n"
+            f"# {len(rows)} jobs, {USERS_PER_SHARD} users/job. Smoke first: condor/oppu_rep_q4tdepth_smoke.sub.\n"
+            "# Generated by condor/gen_oppu_subs.py — edit the generator.\n\n"
+            + header("oppu_rep_q4tdepth_user_d$(depth)_$(ustart)",
+                     f"{ROOT}/oppu_replication/run_oppu.py",
+                     Q4TDEPTH_ARGS.replace("$(rtag)", "_r5q4td$(depth)"))
+            + "\nqueue task, rootname, promptrel, depth, ustart, uend from (\n" + "".join(rows) + ")\n")
+
+
+def q4tdepth_score_sub():
+    rows = [f"    {d}\n" for d in DEPTHS]
