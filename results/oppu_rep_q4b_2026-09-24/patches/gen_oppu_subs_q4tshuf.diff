+# --- Shuffled-history control at 4-bit (2026-09-24) -------------------------------
+# experiments/2026-09-24-shuffled-control-4bit-plan.md. The _r5q4t pipeline (P26
+# 4-bit base, r5 recipe P19) combined with the P23 cyclic permutation: user i trains
+# on user (i+1) mod N's history of the same task, exactly as _r5shuf did at 16-bit.
+# The mapping uses the global user index, so it is identical to _r5shuf under any
+# sharding. Nothing else changes. Tag _r5q4tshuf; _r5, _r5q4, _r5q4t, _r5shuf are
+# never written. Movie tagging is required; news categorization is optional and is
+# submitted at job priority -10 so it only takes slots movie tagging does not need.
+Q4TSHUF_ARGS = Q4T_ARGS + " --shuffle-users"
+Q4TSHUF_TASKS = ["movie_tagging", "news_categorize"]
+
+
+def q4tshuf_user_sub(task, priority=0):
+    n = dict(TASKS)[task]
+    rootname, promptrel = K0_ROOTS[task]
+    rows = [f"    {task} {rootname} {promptrel} {s} {min(s + USERS_PER_SHARD, n)}\n"
+            for s in range(0, n, USERS_PER_SHARD)]
+    prio = f"priority              = {priority}\n" if priority else ""
+    return (f"# Shuffled-history control at 4-bit, {task}: {len(rows)} jobs, {USERS_PER_SHARD} users/job.\n"
+            "# _r5q4t (P26 + P19) plus --shuffle-users (P23). Check the [PATCH P23] mapping\n"
+            "# lines and train_history_user_index in the meta, not the exit code.\n"
+            "# Generated by condor/gen_oppu_subs.py — edit the generator.\n\n"
+            + header("oppu_rep_q4tshuf_user_$(task)_$(ustart)",
+                     f"{ROOT}/oppu_replication/run_oppu.py",
+                     Q4TSHUF_ARGS.replace("$(rtag)", "_r5q4tshuf"))
+            + prio
+            + "\nqueue task, rootname, promptrel, ustart, uend from (\n" + "".join(rows) + ")\n")
+
+
+def q4tshuf_score_sub(task):
+    return ("# Score the 4-bit shuffled-history arm (_r5q4tshuf) against the 4-bit Task arm (_q4).\n"
+            "# CPU-only, in-container. NEVER run this on a login node.\n"
+            "# Generated by condor/gen_oppu_subs.py — edit the generator.\n\n"
+            + header("oppu_rep_q4tshuf_score_$(task)",
+                     f"{ROOT}/oppu_replication/run_scoring_in_container.sh",
+                     (f"{ROOT}/eval/oppu_rep_score.py --task $(task) "
+                      "--oppu-tag _r5q4tshuf --task-tag _q4 --out-tag _r5q4tshuf "
+                      f"--results-root {ROOT}/results/$(rootname)"),
+                     memory="16G", gpu=False)
+            + f"\nqueue task, rootname from (\n    {task} {K0_ROOTS[task][0]}\n)\n")
+
 
