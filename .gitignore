# Round-5 per-user OPPU configs (generator: data/lamp_user_stats/round5_gen_configs.py)
train/config/user_lora_lamp3_oppu_u*.json
# Round-6 per-user OPPU configs (generator: data/lamp_user_stats/round6_gen_configs.py)
train/config/user_lora_lamp4_oppu_u*.json
# LL4-LL6 per-user LongLaMP User-LoRA configs (generator: data/longlamp_user_stats/gen_configs.py)
train/config/longlamp_user_lora_*_oppu.json
# R10-R14 / PT3-PT7 per-user OPPU configs for the five remaining LaMP tasks
# (generator: data/lamp_user_stats/newtask_gen_configs.py). The per-track
# *_template.json files are NOT ignored — those are the committed recipe record.
train/config/user_lora_lamp1_oppu_u*.json
train/config/user_lora_lamp2movies_oppu_u*.json
train/config/user_lora_lamp2news_oppu_u*.json
train/config/user_lora_lamp5_oppu_u*.json
train/config/user_lora_lamp7_oppu_u*.json

# Warm-Start round per-user configs, 7 tasks x 2 arms = 1,254 files
# (generator: data/lamp_user_stats/warm_gen_configs.py). Deterministically
# derivable from the pool JSONs + the two committed
# warm_user_lora_<tag>_<arm>_template.json files per task, which are NOT
# ignored — those are the recipe record.
train/config/user_lora_*_u*_warm.json
train/config/user_lora_*_u*_coldmatch.json

# On-device phase (2026-06) — large external/build artifacts
.venv-mlx/
# mlx-swift-examples is vendored via git subtree (see ios/README.md); track the
# source, ignore only build output + Xcode per-user state.
ios/mlx-swift-examples/build/
ios/mlx-swift-examples/**/xcuserdata/
ios/mlx-swift-examples/**/*.xcuserstate
# mlx-swift-lm vendored as a LOCAL SPM override (Phase 3 gradient-checkpointing
# experiment): track the source, ignore SPM build output.
ios/mlx-swift-lm-local/.build/
*.DS_Store*

# OPPU replication round (2026-08-11)
.venv-audit/
data/oppu_release/
third_party/OPPU/
__pycache__/

# Build output and tool scratch, never worth tracking
ios/BGProbe/build/
ios/**/xcuserdata/
train/checkpoints_mlx/
.playwright-mcp/
*.bak-*
*.pre-final

